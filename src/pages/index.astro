---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import SkillNode from "../components/SkillNode.astro";
import SectionTile from "../components/SectionTile.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LeadershipCard from "../components/LeadershipCard.astro";
import CertSticker from "../components/CertSticker.astro";
import ContactSection from "../components/ContactSection.astro";

const allExperience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);
const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const allLeadership = (await getCollection("leadership")).sort(
  (a, b) => a.data.order - b.data.order
);
const allCerts = (await getCollection("certifications")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout>
  <!-- 00. Hero Section with Interactive Status Terminal -->
  <Hero />

  <!-- 01. About Section -->
  <AboutSection />

  <!-- 02. Skills Topology Matrix -->
  <SkillNode />

  <!-- 03. Professional Experience -->
  <SectionTile
    id="experience"
    code="SEC-03 // PROFESSIONAL_TIMELINE"
    title="PENGALAMAN KERJA"
    subtitle="Rekam jejak profesional dalam pelabelan data machine learning dan rekayasa perangkat lunak full-stack."
    accent="yellow"
  >
    <div class="experience-list">
      {
        allExperience.map((item, idx) => (
          <ExperienceCard
            role={item.data.role}
            org={item.data.org}
            period={item.data.period}
            location={item.data.location}
            badge={item.data.badge}
            bullets={item.data.bullets}
            tech={item.data.tech}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 04. Projects Showcase -->
  <SectionTile
    id="projects"
    code="SEC-04 // FEATURED_BUILDS"
    title="PROYEK & STUDI KASUS"
    subtitle="Koleksi proyek nyata dan studi kasus arsitektur perangkat lunak, sistem AI, aplikasi warga, dan tool diagnostik jaringan."
    accent="blue"
  >
    <div class="projects-grid">
      {
        allProjects.map((proj, idx) => (
          <ProjectCard
            title={proj.data.title}
            subtitle={proj.data.subtitle}
            description={proj.data.description}
            category={proj.data.category}
            featured={proj.data.featured}
            tags={proj.data.tags}
            highlights={proj.data.highlights}
            metrics={proj.data.metrics}
            github={proj.data.github}
            demo={proj.data.demo}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 05. Leadership & Civic Engagement -->
  <SectionTile
    id="leadership"
    code="SEC-05 // COMMUNITY_LEADERSHIP"
    title="KEPEMIMPINAN & SOSIAL"
    subtitle="Dedikasi kepemimpinan organisasi, manajemen media komunitas, dan pelayanan publik administrasi rukun tetangga."
    accent="yellow"
  >
    <div class="leadership-grid">
      {
        allLeadership.map((lead, idx) => (
          <LeadershipCard
            role={lead.data.role}
            org={lead.data.org}
            period={lead.data.period}
            category={lead.data.category}
            bullets={lead.data.bullets}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 06. Education & Certifications -->
  <SectionTile
    id="certifications"
    code="SEC-06 // ACADEMIC_&_CERTS"
    title="PENDIDIKAN & SERTIFIKASI"
    subtitle="Fondasi pendidikan formal Sarjana TI serta sertifikasi resmi Cisco CCNAv7 dan Keselamatan Kerja (K3)."
    accent="green"
  >
    <div class="edu-certs-container">
      <!-- Education Track Cards -->
      <div class="education-block" id="education">
        <h3 class="subsection-title mono">&gt; RIWAYAT PENDIDIKAN FORMAL</h3>
        <div class="education-grid">
          <!-- College -->
          <div class="edu-card brutal-card">
            <div class="edu-top">
              <span class="tag tag-yellow">S-1 SARJANA</span>
              <span class="edu-year mono">2021 – 2025</span>
            </div>
            <h4 class="edu-degree">Sarjana Teknologi Informasi (S-1)</h4>
            <h5 class="edu-school">Universitas Darma Persada, Jakarta</h5>
            <div class="edu-badge-ipk">
              <span class="mono">IPK: <strong>3.34 / 4.00</strong> (Sangat Memuaskan)</span>
            </div>
            <p class="edu-desc">
              Fokus kurikulum pada Rekayasa Perangkat Lunak, Basis Data Relasional, Arsitektur Jaringan, Pemrograman Berorientasi Objek, dan Keamanan Sistem Informasi.
            </p>
          </div>

          <!-- High School -->
          <div class="edu-card brutal-card">
            <div class="edu-top">
              <span class="tag tag-blue">SMK VOKASI</span>
              <span class="edu-year mono">2015 – 2018</span>
            </div>
            <h4 class="edu-degree">Teknik Elektronika (Audio Video)</h4>
            <h5 class="edu-school">SMKN 5 Jakarta</h5>
            <p class="edu-desc">
              Membangun fondasi logika sirkuit, pengukuran sinyal, elektronika digital, troubleshooting hardware, dan keselamatan bengkel kerja teknis.
            </p>
          </div>
        </div>
      </div>

      <!-- Certifications Sticker Board -->
      <div class="certs-block">
        <h3 class="subsection-title mono">&gt; SERTIFIKASI KOMPETENSI (CISCO & K3 SAFETY)</h3>
        <div class="certs-sticker-grid">
          {
            allCerts.map((c, idx) => (
              <CertSticker
                name={c.data.name}
                issuer={c.data.issuer}
                category={c.data.category}
                code={c.data.code}
                status={c.data.status}
                index={idx}
              />
            ))
          }
        </div>
      </div>
    </div>
  </SectionTile>

  <!-- 07. Contact & Dispatch Gateway -->
  <ContactSection />
</BaseLayout>

<style>
  /* Experience List */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 850px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Leadership Grid */
  .leadership-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .leadership-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Education & Certs Container */
  .edu-certs-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .subsection-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1.25rem;
    padding-left: 0.5rem;
    border-left: 4px solid var(--signal-yellow);
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .education-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .edu-card {
    background: #FFFFFF;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .edu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px dashed rgba(16, 16, 16, 0.2);
  }

  .edu-year {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .edu-degree {
    font-size: 1.3rem;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }

  .edu-school {
    font-family: var(--font-subhead);
    font-size: 1rem;
    font-weight: 700;
    color: var(--circuit-blue);
    margin-bottom: 0.75rem;
  }

  .edu-badge-ipk {
    background: var(--signal-yellow-light);
    border: 1px solid var(--ink);
    padding: 0.35rem 0.6rem;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .edu-desc {
    font-size: 0.9rem;
    color: #444444;
    line-height: 1.55;
    margin-top: auto;
  }

  /* Certs Sticker Grid */
  .certs-sticker-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 0.5rem 0;
  }

  @media (min-width: 640px) {
    .certs-sticker-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .certs-sticker-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
