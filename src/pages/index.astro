---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import SkillNode from "../components/SkillNode.astro";
import SectionTile from "../components/SectionTile.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LeadershipCard from "../components/LeadershipCard.astro";
import CertSticker from "../components/CertSticker.astro";
import ContactSection from "../components/ContactSection.astro";

const allExperience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);
const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const allLeadership = (await getCollection("leadership")).sort(
  (a, b) => a.data.order - b.data.order
);
const allCerts = (await getCollection("certifications")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout>
  <!-- 01. Hero Section -->
  <Hero />

  <!-- 02. About Section -->
  <AboutSection />

  <!-- 03. Skills & Technology Matrix -->
  <SkillNode />

  <!-- 04. Professional Experience -->
  <SectionTile
    id="experience"
    badge="04 · Rekam Jejak"
    title="Pengalaman Kerja"
    subtitle="Pengalaman profesional dalam pelabelan data machine learning di KUPU ID dan rekayasa aplikasi web/mobile full-stack."
    accentColor="blue"
  >
    <div class="experience-list">
      {
        allExperience.map((item, idx) => (
          <ExperienceCard
            role={item.data.role}
            org={item.data.org}
            period={item.data.period}
            location={item.data.location}
            badge={item.data.badge}
            bullets={item.data.bullets}
            tech={item.data.tech}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 05. Featured Projects & Case Studies -->
  <SectionTile
    id="projects"
    badge="05 · Portofolio Karya"
    title="Proyek & Studi Kasus"
    subtitle="Koleksi proyek nyata mencakup sistem deteksi medis AI (CNN), asisten percakapan LLM, platform reservasi tiket, dan portal layanan klien."
    accentColor="red"
  >
    <div class="projects-grid">
      {
        allProjects.map((proj, idx) => (
          <ProjectCard
            title={proj.data.title}
            subtitle={proj.data.subtitle}
            description={proj.data.description}
            category={proj.data.category}
            featured={proj.data.featured}
            image={proj.data.image}
            gallery={proj.data.gallery}
            tags={proj.data.tags}
            highlights={proj.data.highlights}
            metrics={proj.data.metrics}
            github={proj.data.github}
            demo={proj.data.demo}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 06. Education & Certifications -->
  <SectionTile
    id="certifications"
    badge="06 · Akademi & Kredensial"
    title="Pendidikan & Sertifikasi"
    subtitle="Fondasi pendidikan formal S-1 Teknologi Informasi serta sertifikasi kompetensi resmi Cisco dan Keselamatan Kerja (K3)."
    accentColor="green"
  >
    <div class="edu-certs-wrapper">

      <!-- Education Cards -->
      <div id="education">
        <h3 class="subblock-title">Riwayat Pendidikan Formal</h3>
        <div class="education-grid">
          <!-- S-1 -->
          <div class="edu-nb-card nb-card">
            <div class="edu-nb-top">
              <span class="tag tag-blue">S-1 · 2021–2025</span>
              <span class="edu-nb-period mono">IPK 3.34 / 4.00</span>
            </div>
            <h4 class="edu-nb-degree">Sarjana Teknologi Informasi</h4>
            <p class="edu-nb-inst">Universitas Darma Persada, Jakarta</p>
            <div class="edu-nb-gpa-box">
              <span class="tag tag-yellow">Sangat Memuaskan</span>
            </div>
            <p class="edu-nb-desc">
              Kurikulum mencakup Rekayasa Perangkat Lunak, Arsitektur Jaringan Komputer,
              Basis Data Relasional, Pemrograman Berorientasi Objek, dan Keamanan Sistem Informasi.
            </p>
          </div>

          <!-- SMK -->
          <div class="edu-nb-card nb-card">
            <div class="edu-nb-top">
              <span class="tag">SMK · 2015–2018</span>
            </div>
            <h4 class="edu-nb-degree">Teknik Elektronika (Audio Video)</h4>
            <p class="edu-nb-inst">SMKN 5 Jakarta</p>
            <p class="edu-nb-desc">
              Fondasi logika sirkuit, elektronika digital, troubleshooting hardware,
              dan keselamatan bengkel kerja teknis.
            </p>
          </div>
        </div>
      </div>

      <!-- Certifications -->
      <div>
        <h3 class="subblock-title">Sertifikasi Kompetensi Resmi</h3>
        <div class="certs-grid">
          {
            allCerts.map((c, idx) => (
              <CertSticker
                name={c.data.name}
                issuer={c.data.issuer}
                category={c.data.category}
                code={c.data.code}
                status={c.data.status}
                index={idx}
              />
            ))
          }
        </div>
      </div>

    </div>
  </SectionTile>

  <!-- 07. Leadership & Civic Engagement -->
  <SectionTile
    id="leadership"
    badge="07 · Pengabdian Masyarakat"
    title="Kepemimpinan & Organisasi"
    subtitle="Dedikasi kepemimpinan organisasi, manajemen komunikasi media komunitas, dan pelayanan publik administrasi rukun tetangga."
    accentColor="yellow"
  >
    <div class="leadership-grid">
      {
        allLeadership.map((lead, idx) => (
          <LeadershipCard
            role={lead.data.role}
            org={lead.data.org}
            period={lead.data.period}
            category={lead.data.category}
            bullets={lead.data.bullets}
            index={idx}
          />
        ))
      }
    </div>
  </SectionTile>

  <!-- 08. Contact Section -->
  <ContactSection />
</BaseLayout>

<style>
  /* Experience List */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Education & Certifications */
  .edu-certs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .subblock-title {
    font-family: var(--font-sub);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: var(--border-2);
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .education-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .edu-nb-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .edu-nb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .edu-nb-period {
    font-size: 0.72rem;
    font-weight: 700;
    color: #777;
    text-transform: uppercase;
  }

  .edu-nb-degree {
    font-family: var(--font-sub);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: none;
  }

  .edu-nb-inst {
    font-size: 0.82rem;
    color: #666;
  }

  .edu-nb-gpa-box {
    display: flex;
  }

  .edu-nb-desc {
    font-size: 0.85rem;
    color: #444;
    line-height: 1.6;
    margin-top: 0.35rem;
  }

  /* Certs Grid */
  .certs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .certs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Leadership Grid */
  .leadership-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .leadership-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
