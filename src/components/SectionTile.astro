---
interface Props {
  id: string;
  badge: string;
  title: string;
  subtitle?: string;
  accentColor?: "yellow" | "blue" | "red" | "green" | "dark" | "purple" | "orange";
}
const { id, badge, title, subtitle, accentColor = "yellow" } = Astro.props;

const accentBg: Record<string,string> = {
  yellow: "var(--yellow)", blue: "var(--blue)", red: "var(--red)",
  green: "var(--green)", dark: "var(--ink)", purple: "var(--purple)", orange: "var(--orange)",
};
const accentFg: Record<string,string> = {
  yellow: "var(--ink)", blue: "#fff", red: "#fff",
  green: "#fff", dark: "#fff", purple: "#fff", orange: "#fff",
};
---

<section id={id} class="section sec-wrap">
  <div class="container">
    <div class="sec-hdr">
      <div class="sec-hdr-left">
        <span class="sec-badge" style={`background:${accentBg[accentColor]};color:${accentFg[accentColor]};`}>
          {badge}
        </span>
        <h2 class="sec-title">{title}</h2>
        {subtitle && <p class="sec-sub">{subtitle}</p>}
      </div>
      <div class="sec-deco" aria-hidden="true">
        <span class="deco-star">✦</span>
      </div>
    </div>

    <div class="sec-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .sec-wrap { position: relative; }

  .sec-hdr {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: var(--border);
  }

  .sec-hdr-left { display: flex; flex-direction: column; gap: 0.4rem; }

  .deco-star {
    font-size: 2.5rem;
    color: rgba(13,13,13,0.08);
    font-family: var(--font-display);
    line-height: 1;
  }

  @media (max-width: 639px) { .deco-star { display: none; } }

  .sec-body { position: relative; }
</style>
