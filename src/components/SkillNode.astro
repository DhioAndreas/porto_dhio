---
// SkillNode.astro — Premium Neubrutalism Skills Bento
---

<section id="skills" class="section">
  <div class="container">

    <div class="sk-hdr">
      <span class="sec-badge" style="background:var(--blue);color:#fff;">// 02 — Keahlian</span>
      <h2 class="sec-title">Tech Stack &amp; Skills</h2>
      <p class="sec-sub">Teknologi yang saya kuasai dan gunakan dalam proyek nyata.</p>
    </div>

    <div class="sk-grid">

      <!-- WEB DEV → 2-col wide, white -->
      <div class="sk-tile sk-web" id="skill-web">
        <div class="sk-head">
          <span class="sk-ico">🌐</span>
          <h3 class="sk-ttl">Web Development</h3>
          <span class="sk-num">01</span>
        </div>
        <div class="sk-chips">
          <span class="chip solid">Laravel</span>
          <span class="chip solid">React.js</span>
          <span class="chip">PHP</span>
          <span class="chip">JavaScript</span>
          <span class="chip">HTML / CSS</span>
          <span class="chip">Bootstrap</span>
          <span class="chip">Tailwind</span>
          <span class="chip">CodeIgniter</span>
        </div>
      </div>

      <!-- SOFT SKILLS → tall yellow right -->
      <div class="sk-tile sk-soft sk-yellow" id="skill-soft">
        <div class="sk-head">
          <span class="sk-ico">🧠</span>
          <h3 class="sk-ttl">Soft Skills</h3>
          <span class="sk-num">07</span>
        </div>
        <ul class="soft-list">
          <li>Problem Solving &amp; Analytical</li>
          <li>Adaptasi teknologi baru</li>
          <li>Kolaborasi tim lintas fungsi</li>
          <li>Komunikasi teknis &amp; dokumentasi</li>
          <li>Manajemen waktu &amp; prioritas</li>
          <li>Kepemimpinan &amp; civic engagement</li>
        </ul>
        <div class="soft-bottom-tag">
          <span>Interpersonal ✦ Leadership ✦ Critical Thinking</span>
        </div>
      </div>

      <!-- MOBILE DEV → blue-light -->
      <div class="sk-tile sk-mobile sk-purple" id="skill-mobile">
        <div class="sk-head">
          <span class="sk-ico">📱</span>
          <h3 class="sk-ttl">Mobile Dev</h3>
          <span class="sk-num">02</span>
        </div>
        <div class="sk-chips">
          <span class="chip solid">Flutter</span>
          <span class="chip solid">Dart</span>
          <span class="chip">Android SDK</span>
          <span class="chip">REST API</span>
        </div>
      </div>

      <!-- DATABASE → green light -->
      <div class="sk-tile sk-db sk-green" id="skill-db">
        <div class="sk-head">
          <span class="sk-ico">🗄️</span>
          <h3 class="sk-ttl">Database</h3>
          <span class="sk-num">04</span>
        </div>
        <div class="sk-chips">
          <span class="chip solid">MySQL</span>
          <span class="chip solid">PostgreSQL</span>
          <span class="chip">SQLite</span>
          <span class="chip">Firebase</span>
          <span class="chip">Eloquent ORM</span>
        </div>
      </div>

      <!-- AI / ML → red light, 2-col wide -->
      <div class="sk-tile sk-ai sk-red" id="skill-ai">
        <div class="sk-head">
          <span class="sk-ico">🤖</span>
          <h3 class="sk-ttl">AI &amp; Machine Learning</h3>
          <span class="sk-num">03</span>
        </div>
        <div class="sk-chips">
          <span class="chip solid">Python</span>
          <span class="chip solid">TensorFlow / Keras</span>
          <span class="chip solid">CNN Deep Learning</span>
          <span class="chip">OpenCV</span>
          <span class="chip">LLM / RAG</span>
          <span class="chip">Data Annotation</span>
          <span class="chip">Ollama</span>
          <span class="chip">Streamlit</span>
          <span class="chip">Flask / FastAPI</span>
        </div>
      </div>

      <!-- NETWORKING → dark/ink -->
      <div class="sk-tile sk-net sk-dark" id="skill-net">
        <div class="sk-head sk-head-light">
          <span class="sk-ico">🔌</span>
          <h3 class="sk-ttl">Networking</h3>
          <span class="sk-num" style="color:rgba(255,255,255,0.2)">05</span>
        </div>
        <div class="sk-chips">
          <span class="chip chip-light solid">Cisco CCNAv7</span>
          <span class="chip chip-light">TCP/IP</span>
          <span class="chip chip-light">Routing</span>
          <span class="chip chip-light">VLAN</span>
          <span class="chip chip-light">Packet Tracer</span>
        </div>
      </div>

      <!-- TOOLS → full width, dark -->
      <div class="sk-tile sk-tools sk-dark" id="skill-tools">
        <div class="sk-head sk-head-light">
          <span class="sk-ico">⚙️</span>
          <h3 class="sk-ttl">Tools &amp; DevOps</h3>
          <span class="sk-num" style="color:rgba(255,255,255,0.2)">06</span>
        </div>
        <div class="sk-chips">
          <span class="chip chip-light solid">Git / GitHub</span>
          <span class="chip chip-light">VS Code</span>
          <span class="chip chip-light">Postman</span>
          <span class="chip chip-light">Figma</span>
          <span class="chip chip-light">Linux CLI</span>
          <span class="chip chip-light">cPanel</span>
          <span class="chip chip-light">Composer</span>
          <span class="chip chip-light">NPM / Vite</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .sk-hdr { margin-bottom: 2.5rem; }

  /* ── BENTO GRID ── */
  .sk-grid {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .sk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sk-ai    { grid-column: 1 / 3; }
    .sk-tools { grid-column: 1 / 3; }
  }

  @media (min-width: 960px) {
    .sk-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-areas:
        "web    web    soft"
        "mobile db     soft"
        "ai     ai     net"
        "tools  tools  tools";
    }
    .sk-web    { grid-area: web; }
    .sk-soft   { grid-area: soft; }
    .sk-mobile { grid-area: mobile; }
    .sk-db     { grid-area: db; }
    .sk-ai     { grid-area: ai; }
    .sk-net    { grid-area: net; }
    .sk-tools  { grid-area: tools; flex-direction: row; align-items: center; gap: 1.5rem; }
    .sk-tools .sk-head { flex-shrink:0; min-width:160px; border-right: var(--border-2); border-bottom:none; padding-right:1.5rem; padding-bottom:0; margin-right: 0.5rem; }
  }

  /* ── Tile Base ── */
  .sk-tile {
    background: var(--paper-card);
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .sk-tile:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  /* Color variants */
  .sk-yellow  { background: var(--yellow); }
  .sk-purple  { background: var(--purple-light); }
  .sk-green   { background: var(--green-light); }
  .sk-red     { background: var(--red-light); }
  .sk-dark    { background: var(--ink); }

  /* ── Tile Head ── */
  .sk-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.9rem;
    border-bottom: var(--border-2);
  }

  .sk-head-light { border-bottom-color: rgba(255,255,255,0.15); }

  .sk-ico { font-size: 1.2rem; line-height: 1; flex-shrink: 0; }

  .sk-ttl {
    font-family: var(--font-display);
    font-size: 0.88rem;
    text-transform: uppercase;
    color: var(--ink);
    flex: 1;
  }

  .sk-dark .sk-ttl { color: #fff; }

  .sk-num {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    font-weight: 700;
    color: rgba(13,13,13,0.07);
    line-height: 1;
    flex-shrink: 0;
    letter-spacing: -0.04em;
  }

  /* ── Chips ── */
  .sk-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: var(--border-2);
    background: rgba(13,13,13,0.05);
    color: var(--ink);
    box-shadow: 2px 2px 0 rgba(13,13,13,0.15);
    line-height: 1.4;
    letter-spacing: 0.03em;
    transition: transform 0.08s, box-shadow 0.08s;
  }

  .chip:hover { transform: translate(1px,1px); box-shadow: 1px 1px 0 rgba(13,13,13,0.15); }

  .chip.solid {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.35);
  }

  /* Light chip for dark tiles */
  .chip-light {
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.85);
    border-color: rgba(255,255,255,0.2);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .chip-light:hover { box-shadow: 1px 1px 0 rgba(0,0,0,0.3); }

  .chip-light.solid {
    background: var(--yellow);
    color: var(--ink);
    border-color: transparent;
  }

  /* ── Soft Skills ── */
  .soft-list {
    list-style: none;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .soft-list li {
    font-size: 0.86rem;
    color: var(--ink);
    font-weight: 600;
    padding-left: 1.1rem;
    position: relative;
    line-height: 1.4;
    font-family: var(--font-sub);
  }

  .soft-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(0,0,0,0.5);
    top: 1px;
  }

  .soft-bottom-tag {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: var(--border-2);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(0,0,0,0.4);
  }
</style>
