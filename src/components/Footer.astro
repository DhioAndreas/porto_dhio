---
// Footer.astro — Neubrutalism Footer
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">

      <!-- Brand -->
      <div class="footer-brand">
        <span class="footer-logo">DAG</span>
        <p class="footer-name">Dhio Andreas Gemilang</p>
        <p class="footer-tagline">Full-Stack Developer · Jakarta, Indonesia</p>
      </div>

      <!-- Quick Links -->
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="#about"          class="footer-link">Tentang</a>
        <a href="#skills"         class="footer-link">Keahlian</a>
        <a href="#experience"     class="footer-link">Pengalaman</a>
        <a href="#projects"       class="footer-link">Proyek</a>
        <a href="#certifications" class="footer-link">Sertifikasi</a>
        <a href="#leadership"     class="footer-link">Organisasi</a>
        <a href="#contact"        class="footer-link">Kontak</a>
      </nav>

      <!-- Socials -->
      <div class="footer-socials">
        <a
          href="https://linkedin.com/in/dhioandreas"
          target="_blank"
          rel="noopener"
          class="social-pill"
          aria-label="LinkedIn"
        >in</a>
        <a
          href="https://github.com/DhioAndreas"
          target="_blank"
          rel="noopener"
          class="social-pill"
          aria-label="GitHub"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a
          href="mailto:dhioandreas4@gmail.com"
          class="social-pill"
          aria-label="Email"
        >@</a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <span class="mono footer-copy">© {year} Dhio Andreas Gemilang. All rights reserved.</span>
      <a href="#hero" class="back-top btn btn-yellow btn-sm">↑ Kembali ke atas</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    border-top: var(--border);
    color: #fff;
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3rem 0 2rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 200px 1fr auto;
      align-items: start;
    }
  }

  /* Brand */
  .footer-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    background: var(--yellow);
    color: var(--ink);
    padding: 0.2rem 0.55rem;
    border: var(--border-2);
    margin-bottom: 0.6rem;
  }

  .footer-name {
    font-family: var(--font-sub);
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .footer-tagline {
    font-size: 0.75rem;
    color: #999;
    margin-top: 0.2rem;
  }

  /* Nav */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .footer-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      align-items: flex-start;
    }
  }

  .footer-link {
    font-family: var(--font-sub);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #aaa;
    text-decoration: none;
    transition: color 0.12s;
  }

  .footer-link:hover {
    color: var(--yellow);
  }

  /* Socials */
  .footer-socials {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .social-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #fff;
    color: var(--ink);
    border: var(--border-2);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 900;
    text-decoration: none;
    transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
  }

  .social-pill:hover {
    background: var(--yellow);
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-pressed);
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 2px solid #222;
  }

  .footer-copy {
    font-size: 0.72rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
