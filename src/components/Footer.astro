<footer class="site-footer">
  <div class="hazard-stripe"></div>

  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand & Bio Summary -->
      <div class="footer-col footer-col-brand">
        <div class="footer-brand-badge">
          <span class="brand-initials">DAG</span>
          <span class="brand-divider">/</span>
          <span class="brand-name">DHIO ANDREAS GEMILANG</span>
        </div>
        <p class="footer-bio">
          Full-Stack Developer, Sarjana Teknologi Informasi (IPK 3.34), pemegang sertifikasi jaringan Cisco CCNAv7 & K3 Safety Practitioner. Berdomisili di Klender, Jakarta Timur.
        </p>
        <div class="footer-status-pill mono">
          <span class="status-green-dot">●</span>
          <span>AVAILABLE FOR NEW OPPORTUNITIES</span>
        </div>
      </div>

      <!-- Col 2: Navigation Sitemap -->
      <div class="footer-col">
        <h4 class="footer-col-title mono">&gt; SITE NAVIGATION</h4>
        <ul class="footer-nav-list">
          <li><a href="#hero">00. Home & Status Terminal</a></li>
          <li><a href="#about">01. About Profile & Pillars</a></li>
          <li><a href="#skills">02. Skills & Node Matrix</a></li>
          <li><a href="#experience">03. Professional Experience</a></li>
          <li><a href="#projects">04. Featured Projects</a></li>
          <li><a href="#leadership">05. Leadership & Civic Roles</a></li>
          <li><a href="#education">06. Education & Certifications</a></li>
          <li><a href="#contact">07. Contact & Dispatch</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Connect & Live Clock -->
      <div class="footer-col">
        <h4 class="footer-col-title mono">&gt; SYSTEM CLOCK & CONTACT</h4>
        <div class="live-clock-card mono" id="live-clock-widget">
          <span class="clock-label">JAKARTA LOCAL TIME (WIB):</span>
          <span class="clock-time" id="jakarta-time">--:--:-- WIB</span>
          <span class="clock-tz">UTC+07:00 · ASIA/JAKARTA</span>
        </div>

        <div class="footer-quick-reach mono">
          <div>✉ <a href="mailto:dhioandreas50@gmail.com">dhioandreas50@gmail.com</a></div>
          <div>📱 <a href="https://wa.me/6282115107236">+62 821-1510-7236</a></div>
          <div>📍 Klender, Jakarta Timur (13470)</div>
        </div>

        <button id="back-to-top-btn" class="btn btn-sm btn-primary" style="margin-top: 1rem; width: 100%;">
          <span>Kembali ke Atas ↑</span>
        </button>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <div class="mono footer-copy">
        © 2026 DHIO ANDREAS GEMILANG. BUILT WITH ASTRO & NEUBRUTALISM SIGNAL GRID.
      </div>
      <div class="mono footer-specs hide-mobile">
        HOST_STATUS: 200 OK · CCNAv7 // K3 VERIFIED
      </div>
    </div>
  </div>
</footer>

<script>
  // Live Jakarta WIB Clock
  function updateJakartaTime() {
    const clockEl = document.getElementById('jakarta-time');
    if (!clockEl) return;

    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };
    const timeString = new Intl.DateTimeFormat('id-ID', options).format(now);
    clockEl.textContent = `${timeString} WIB`;
  }

  updateJakartaTime();
  setInterval(updateJakartaTime, 1000);

  // Back to Top Button
  const backToTopBtn = document.getElementById('back-to-top-btn');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  .site-footer {
    background-color: var(--ink);
    color: #EDEDED;
    border-top: var(--border-thick);
    margin-top: 4rem;
  }

  .footer-content {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid #2B2F3D;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }

  .footer-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: #FFFFFF;
    background: #1C202C;
    padding: 0.45rem 0.75rem;
    border: 2px solid #3B4256;
    margin-bottom: 1rem;
  }

  .brand-initials {
    color: var(--signal-yellow);
  }

  .brand-divider {
    color: #666666;
  }

  .footer-bio {
    font-size: 0.9rem;
    color: #B0B5C4;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .footer-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(0, 200, 83, 0.12);
    border: 1px solid var(--terminal-green);
    color: var(--terminal-green);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
  }

  .status-green-dot {
    color: var(--terminal-green);
    animation: pulse 1.5s infinite;
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--signal-yellow);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav-list a {
    color: #C2C7D6;
    font-family: var(--font-subhead);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .footer-nav-list a:hover {
    color: var(--signal-yellow);
    padding-left: 0.35rem;
  }

  .live-clock-card {
    background: #141721;
    border: 2px solid #2B3042;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .clock-label {
    font-size: 0.68rem;
    color: #8C93A8;
    font-weight: 700;
  }

  .clock-time {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--signal-yellow);
  }

  .clock-tz {
    font-size: 0.65rem;
    color: #6C7387;
  }

  .footer-quick-reach {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #B0B5C4;
  }

  .footer-quick-reach a {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .footer-quick-reach a:hover {
    color: var(--signal-yellow);
  }

  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    font-size: 0.78rem;
    color: #7D8498;
  }

  .hide-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .hide-mobile {
      display: block;
    }
  }
</style>
