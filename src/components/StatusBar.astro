---
---

<div class="terminal-container" id="terminal-widget">
  <!-- Terminal Top Bar -->
  <div class="terminal-topbar">
    <div class="terminal-buttons">
      <span class="btn-dot dot-red"></span>
      <span class="btn-dot dot-yellow"></span>
      <span class="btn-dot dot-green"></span>
    </div>
    <div class="terminal-title">
      <span class="mono">bash — dhio@cisco-node-01:~ (CCNAv7)</span>
    </div>
    <div class="terminal-badge">
      <span class="status-live-pulse"></span>
      <span>ONLINE</span>
    </div>
  </div>

  <!-- Terminal Body -->
  <div class="terminal-body mono">
    <div class="term-line">
      <span class="term-prompt">$</span> <span class="term-cmd">ping dhio-portfolio --status</span>
    </div>
    <div class="term-output">
      <div class="term-row"><span class="term-key">&gt; HOST:</span> <span class="term-val-highlight">dhio-andreas-gemilang.local</span></div>
      <div class="term-row"><span class="term-key">&gt; STATUS:</span> <span class="term-badge-avail">● AVAILABLE FOR WORK / COLLAB</span></div>
      <div class="term-row"><span class="term-key">&gt; UPTIME:</span> <span class="term-val">Graduate S1 IT Darma Persada (2025) · IPK 3.34</span></div>
      <div class="term-row"><span class="term-key">&gt; LOCATION:</span> <span class="term-val">Klender, Jakarta Timur (13470)</span></div>
      <div class="term-row"><span class="term-key">&gt; CERTIFICATIONS:</span> <span class="term-val-blue">Cisco CCNAv7 · Cisco IT Essentials · K3 (JSA/FSO/P3K)</span></div>
      <div class="term-row"><span class="term-key">&gt; LATENCY:</span> <span class="term-val-green" id="latency-counter">replies within 24h (~14ms)</span></div>
    </div>

    <!-- Live ICMP Stream Simulation -->
    <div class="term-icmp-stream" id="icmp-log">
      <div class="icmp-line">64 bytes from 192.168.1.50: icmp_seq=1 ttl=64 time=12.4ms</div>
      <div class="icmp-line">64 bytes from 192.168.1.50: icmp_seq=2 ttl=64 time=14.1ms</div>
      <div class="icmp-line">64 bytes from 192.168.1.50: icmp_seq=3 ttl=64 time=11.8ms [PACKET_OK]</div>
    </div>

    <!-- Interactive Command Bar -->
    <div class="term-interactive">
      <div class="term-quick-cmds">
        <span class="cmd-label">Quick Commands:</span>
        <button class="quick-cmd-btn" data-cmd="skills">$ skills</button>
        <button class="quick-cmd-btn" data-cmd="cert">$ cisco --verify</button>
        <button class="quick-cmd-btn" data-cmd="k3">$ safety --jsa</button>
        <button class="quick-cmd-btn" data-cmd="contact">$ reach --email</button>
        <button class="quick-cmd-btn" data-cmd="clear">$ clear</button>
      </div>
      <div class="interactive-output" id="interactive-output"></div>
    </div>
  </div>
</div>

<script>
  // Simulated Live Ping Packet Updates
  const icmpContainer = document.getElementById('icmp-log');
  let seq = 4;

  function addPingPacket() {
    if (!icmpContainer) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ms = (10 + Math.random() * 8).toFixed(1);
    const line = document.createElement('div');
    line.className = 'icmp-line';
    line.textContent = `64 bytes from 192.168.1.50: icmp_seq=${seq} ttl=64 time=${ms}ms`;
    
    // Keep max 4 lines
    if (icmpContainer.children.length >= 4) {
      icmpContainer.removeChild(icmpContainer.children[0]);
    }
    icmpContainer.appendChild(line);
    seq++;
  }

  setInterval(addPingPacket, 3800);

  // Quick Command Handlers
  const cmdBtns = document.querySelectorAll('.quick-cmd-btn');
  const outputEl = document.getElementById('interactive-output');

  const responses: Record<string, string> = {
    skills: "⚡ STACK: Python, Java, PHP, JavaScript, React.js, Laravel, Flutter, MySQL, TensorFlow, Cisco CCNAv7",
    cert: "🔒 CISCO VERIFIED: CCNAv7 (Introduction to Networks) & IT Essentials — Cisco Networking Academy",
    k3: "🦺 K3 CERTIFIED: Job Safety Analysis (JSA), Fire Safety Officer (FSO), First Aid, SMK3 3S Center",
    contact: "📬 DIRECT DISPATCH: dhioandreas50@gmail.com · WA/Tel: +62 821-1510-7236",
    clear: ""
  };

  cmdBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd');
      if (cmd && outputEl) {
        if (cmd === 'clear') {
          outputEl.innerHTML = '';
        } else {
          outputEl.innerHTML = `<div class="cmd-response-line"><span class="cmd-prompt-echo">&gt;&gt;</span> ${responses[cmd]}</div>`;
        }
      }
    });
  });
</script>

<style>
  .terminal-container {
    background-color: var(--terminal-bg);
    border: var(--border-thick);
    box-shadow: var(--shadow-hard);
    color: #F0F0F0;
    overflow: hidden;
    margin-top: 1.5rem;
    position: relative;
  }

  .terminal-topbar {
    background-color: #1A1D26;
    border-bottom: 2px solid var(--ink);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-buttons {
    display: flex;
    gap: 0.45rem;
  }

  .btn-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.4);
    display: inline-block;
  }

  .dot-red { background-color: var(--alert-red); }
  .dot-yellow { background-color: var(--signal-yellow); }
  .dot-green { background-color: var(--terminal-green); }

  .terminal-title {
    font-size: 0.8rem;
    color: #A0A5B5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--terminal-green);
    background: rgba(0, 200, 83, 0.12);
    border: 1px solid var(--terminal-green);
    padding: 0.15rem 0.5rem;
  }

  .status-live-pulse {
    width: 6px;
    height: 6px;
    background-color: var(--terminal-green);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  .terminal-body {
    padding: 1.25rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .term-line {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .term-prompt {
    color: var(--signal-yellow);
    font-weight: 700;
  }

  .term-cmd {
    color: #FFFFFF;
    font-weight: 700;
  }

  .term-output {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
    padding-left: 0.5rem;
    border-left: 2px solid rgba(255, 212, 0, 0.4);
  }

  .term-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }

  .term-key {
    color: #8C93A8;
    font-weight: 600;
  }

  .term-val-highlight {
    color: #FFFFFF;
    font-weight: 700;
  }

  .term-val {
    color: #E2E4E9;
  }

  .term-val-blue {
    color: #7AA2F7;
  }

  .term-val-green {
    color: #4ADE80;
  }

  .term-badge-avail {
    color: #101010;
    background-color: var(--terminal-green);
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.1rem 0.4rem;
  }

  .term-icmp-stream {
    background: rgba(0, 0, 0, 0.4);
    padding: 0.6rem 0.8rem;
    border: 1px dashed #2A2E3D;
    margin-bottom: 1rem;
    font-size: 0.78rem;
    color: #9CA3AF;
  }

  .icmp-line {
    line-height: 1.4;
  }

  .term-interactive {
    border-top: 1px solid #2A2E3D;
    padding-top: 0.85rem;
  }

  .term-quick-cmds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .cmd-label {
    font-size: 0.75rem;
    color: #8C93A8;
    margin-right: 0.25rem;
  }

  .quick-cmd-btn {
    background: #1E222D;
    border: 1px solid #3F4458;
    color: var(--signal-yellow);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .quick-cmd-btn:hover {
    background: var(--signal-yellow);
    color: var(--ink);
    border-color: var(--signal-yellow);
  }

  .interactive-output {
    margin-top: 0.75rem;
  }

  .cmd-response-line {
    background: rgba(30, 64, 255, 0.15);
    border-left: 3px solid var(--circuit-blue);
    padding: 0.5rem 0.75rem;
    color: #E2E8F0;
    font-size: 0.82rem;
    animation: fadeIn 0.2s ease;
  }

  .cmd-prompt-echo {
    color: var(--signal-yellow);
    font-weight: 700;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
