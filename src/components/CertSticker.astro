---
// CertSticker.astro — Neubrutalism Certification Card
interface Props {
  name: string;
  issuer: string;
  category: string;
  code?: string;
  status: string;
  index: number;
}

const { name, issuer, category, code, status, index } = Astro.props;

const catMap: Record<string, { tag: string; icon: string }> = {
  Networking:    { tag: "tag-blue",   icon: "🔌" },
  Safety:        { tag: "tag-red",    icon: "⛑️" },
  IT:            { tag: "tag-purple", icon: "💻" },
  Security:      { tag: "tag-dark",   icon: "🔒" },
};
const meta = catMap[category] ?? { tag: "tag-dark", icon: "📄" };

const verifiedTag = status === "Active" || status === "Verified";
---

<div class="cert-card nb-card nb-card-hover" id={`cert-${index}`}>
  <div class="cert-top">
    <span class={`tag ${meta.tag}`}>{category}</span>
    <span class="cert-icon">{meta.icon}</span>
  </div>

  <h4 class="cert-name">{name}</h4>
  <p class="cert-issuer">{issuer}</p>

  {code && (
    <div class="cert-code mono">{code}</div>
  )}

  <div class="cert-status-row">
    <span class:list={["cert-status", { "status-active": verifiedTag }]}>
      {verifiedTag ? "✓ " : "• "}{status}
    </span>
  </div>
</div>

<style>
  .cert-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .cert-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cert-icon {
    font-size: 1.4rem;
  }

  .cert-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.2;
  }

  .cert-issuer {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: #666;
    font-weight: 600;
  }

  .cert-code {
    font-size: 0.68rem;
    font-weight: 700;
    color: #888;
    background: var(--paper);
    border: var(--border-2);
    padding: 0.15rem 0.45rem;
    display: inline-block;
    width: fit-content;
  }

  .cert-status-row {
    margin-top: 0.25rem;
    border-top: var(--border-2);
    padding-top: 0.5rem;
  }

  .cert-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #888;
  }

  .status-active {
    color: var(--green);
  }
</style>
