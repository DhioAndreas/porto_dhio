---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  category: string;
  featured?: boolean;
  image?: string;
  tags: string[];
  highlights: string[];
  metrics?: string;
  github?: string;
  demo?: string;
  index: number;
}

const {
  title,
  subtitle,
  description,
  category,
  featured = false,
  image,
  tags,
  highlights,
  metrics,
  github,
  demo,
  index,
} = Astro.props;
---

<div class={`project-card brutal-card ${featured ? 'project-featured' : ''}`}>
  <!-- Top Meta Strip -->
  <div class="project-header">
    <div class="project-meta-left">
      <span class="project-idx mono">PROJ_0{index + 1}</span>
      <span class="tag tag-yellow">{category}</span>
      {featured && <span class="tag tag-red">★ FEATURED</span>}
    </div>
    {
      metrics && (
        <div class="project-metrics mono">
          <span class="metrics-dot">●</span>
          <span>{metrics}</span>
        </div>
      )
    }
  </div>

  <!-- Project Visual Screenshot / Mockup Preview -->
  {
    image && (
      <div class="project-media-box">
        <img src={image} alt={`Screenshot ${title}`} class="project-media-img" loading="lazy" />
        <div class="media-overlay-badge mono">
          <span>● LIVE SCREENSHOT</span>
        </div>
      </div>
    )
  }

  <!-- Title & Subtitle -->
  <div class="project-heading-block">
    <h3 class="project-title">{title}</h3>
    <h4 class="project-sub">{subtitle}</h4>
  </div>

  <!-- Description -->
  <p class="project-desc">{description}</p>

  <!-- Architectural Highlights -->
  <div class="project-highlights-box">
    <span class="highlights-title mono">KEY HIGHLIGHTS & ARCHITECTURE:</span>
    <ul class="highlights-list">
      {
        highlights.map((item) => (
          <li>
            <span class="check-icon">✓</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Tech Tags -->
  <div class="project-tags-wrap">
    {tags.map((tag) => <span class="tag tag-blue">{tag}</span>)}
  </div>

  <!-- Actions -->
  <div class="project-actions">
    {
      demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
          <span>Live Demo ↗</span>
        </a>
      )
    }
    {
      github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-sm">
          <span>GitHub Repo ↗</span>
        </a>
      )
    }
    <a href="#contact" class="btn btn-sm btn-blue">
      <span>Diskusi Proyek 💬</span>
    </a>
  </div>
</div>

<style>
  .project-card {
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .project-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-lg);
  }

  .project-featured {
    border-top: 6px solid var(--signal-yellow);
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 1rem;
  }

  .project-meta-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .project-idx {
    font-size: 0.75rem;
    font-weight: 700;
    color: #666666;
  }

  .project-metrics {
    font-size: 0.75rem;
    font-weight: 700;
    background: #F2F4F8;
    border: 1px solid var(--ink);
    padding: 0.15rem 0.5rem;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .metrics-dot {
    color: var(--terminal-green);
  }

  .project-media-box {
    position: relative;
    width: 100%;
    height: 190px;
    background: #11141D;
    border: 2px solid var(--ink);
    margin-bottom: 1rem;
    overflow: hidden;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .project-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.25s ease;
  }

  .project-card:hover .project-media-img {
    transform: scale(1.04);
  }

  .media-overlay-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(16, 16, 16, 0.85);
    color: var(--signal-yellow);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--signal-yellow);
  }

  .project-heading-block {
    margin-bottom: 0.75rem;
  }

  .project-title {
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .project-sub {
    font-family: var(--font-subhead);
    font-size: 0.95rem;
    font-weight: 600;
    color: #555555;
  }

  .project-desc {
    font-size: 0.92rem;
    color: #2D3139;
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .project-highlights-box {
    background: #F8F9FB;
    border: 1px solid var(--ink);
    padding: 0.75rem 0.85rem;
    margin-bottom: 1.25rem;
  }

  .highlights-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: #666666;
    display: block;
    margin-bottom: 0.4rem;
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.84rem;
    color: #333333;
    line-height: 1.4;
  }

  .check-icon {
    color: #059669;
    font-weight: 900;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .project-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 2px dashed rgba(16, 16, 16, 0.2);
  }
</style>
