---
interface GalleryItem {
  src: string;
  caption: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  category: string;
  featured?: boolean;
  image?: string;
  gallery?: GalleryItem[];
  tags: string[];
  highlights: string[];
  metrics?: string;
  github?: string;
  demo?: string;
  index: number;
}

const {
  title,
  subtitle,
  description,
  category,
  featured = false,
  image,
  gallery = [],
  tags,
  highlights,
  metrics,
  github,
  demo,
  index,
} = Astro.props;

const hasGallery = gallery && gallery.length > 0;
const previewImg = hasGallery ? gallery[0].src : image;
const totalSlides = gallery?.length ?? 0;
---

<div class={`project-card brutal-card ${featured ? 'project-featured' : ''}`}>
  <!-- Top Meta Strip -->
  <div class="project-header">
    <div class="project-meta-left">
      <span class="project-idx mono">PROJ_0{index + 1}</span>
      <span class="tag tag-yellow">{category}</span>
      {featured && <span class="tag tag-red">★ FEATURED</span>}
    </div>
    {
      metrics && (
        <div class="project-metrics mono">
          <span class="metrics-dot">●</span>
          <span>{metrics}</span>
        </div>
      )
    }
  </div>

  <!-- Clickable Preview Thumbnail → opens Lightbox Modal -->
  {
    previewImg && (
      <button
        class="project-preview-btn"
        data-title={title}
        data-gallery={JSON.stringify(hasGallery ? gallery : [{ src: previewImg, caption: title }])}
        aria-label={`Lihat galeri ${title}`}
      >
        <div class="project-media-box">
          <img src={previewImg} alt={`Preview ${title}`} class="project-media-img" loading="lazy" />

          <!-- Hover overlay -->
          <div class="preview-hover-overlay">
            <div class="hover-icon-ring">
              <span class="hover-icon">⊞</span>
            </div>
            <span class="hover-label mono">KLIK UNTUK LIHAT GALERI</span>
            {hasGallery && (
              <span class="hover-count mono">{totalSlides} LAYAR TERSEDIA</span>
            )}
          </div>

          <!-- Corner badge -->
          <div class="media-corner-badge mono">
            {hasGallery ? `◉ ${totalSlides} FOTO` : '● PREVIEW'}
          </div>
        </div>
      </button>
    )
  }

  <!-- Title & Subtitle -->
  <div class="project-heading-block">
    <h3 class="project-title">{title}</h3>
    <h4 class="project-sub">{subtitle}</h4>
  </div>

  <!-- Description -->
  <p class="project-desc">{description}</p>

  <!-- Architectural Highlights -->
  <div class="project-highlights-box">
    <span class="highlights-title mono">KEY HIGHLIGHTS & ARCHITECTURE:</span>
    <ul class="highlights-list">
      {
        highlights.map((item) => (
          <li>
            <span class="check-icon">✓</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Tech Tags -->
  <div class="project-tags-wrap">
    {tags.map((tag) => <span class="tag tag-blue">{tag}</span>)}
  </div>

  <!-- Actions -->
  <div class="project-actions">
    {hasGallery && (
      <button
        class="btn btn-sm btn-gallery"
        data-title={title}
        data-gallery={JSON.stringify(gallery)}
        aria-label={`Buka galeri ${title}`}
      >
        <span>🖼 Lihat Galeri ({totalSlides} foto)</span>
      </button>
    )}
    {
      demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
          <span>Live Demo ↗</span>
        </a>
      )
    }
    {
      github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-sm">
          <span>GitHub Repo ↗</span>
        </a>
      )
    }
    <a href="#contact" class="btn btn-sm btn-blue">
      <span>Diskusi Proyek 💬</span>
    </a>
  </div>
</div>

<script>
  function initProjectCardTriggers() {
    document.querySelectorAll<HTMLButtonElement>('[data-gallery]').forEach((btn) => {
      // Avoid registering duplicate listeners
      if (btn.dataset.galleryBound === '1') return;
      btn.dataset.galleryBound = '1';

      btn.addEventListener('click', () => {
        const title = btn.dataset.title ?? '';
        const gallery = JSON.parse(btn.dataset.gallery ?? '[]');
        document.dispatchEvent(
          new CustomEvent('open-project-gallery', { detail: { title, gallery } })
        );
      });
    });
  }

  initProjectCardTriggers();
  document.addEventListener('astro:page-load', initProjectCardTriggers);
</script>

<style>
  .project-card {
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .project-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-lg);
  }

  .project-featured {
    border-top: 6px solid var(--signal-yellow);
  }

  .project-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 1rem;
  }

  .project-meta-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .project-idx {
    font-size: 0.75rem;
    font-weight: 700;
    color: #666666;
  }

  .project-metrics {
    font-size: 0.75rem;
    font-weight: 700;
    background: #F2F4F8;
    border: 1px solid var(--ink);
    padding: 0.15rem 0.5rem;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .metrics-dot {
    color: var(--terminal-green);
  }

  /* Clickable Preview Button */
  .project-preview-btn {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .project-media-box {
    position: relative;
    width: 100%;
    height: 200px;
    background: #0F1219;
    border: 2px solid var(--ink);
    overflow: hidden;
    box-shadow: 3px 3px 0 var(--ink);
    transition: box-shadow 0.15s ease;
  }

  .project-preview-btn:hover .project-media-box {
    box-shadow: 5px 5px 0 var(--ink);
    border-color: var(--signal-yellow);
  }

  .project-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease, filter 0.25s ease;
    display: block;
  }

  .project-preview-btn:hover .project-media-img {
    transform: scale(1.04);
    filter: brightness(0.6);
  }

  /* Hover Overlay */
  .preview-hover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
    background: rgba(10, 12, 18, 0.35);
  }

  .project-preview-btn:hover .preview-hover-overlay {
    opacity: 1;
  }

  .hover-icon-ring {
    width: 52px;
    height: 52px;
    border: 2.5px solid var(--signal-yellow);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 212, 0, 0.12);
    animation: ringPulse 1.2s ease infinite;
  }

  @keyframes ringPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 212, 0, 0.4); }
    50%       { box-shadow: 0 0 0 10px rgba(255, 212, 0, 0); }
  }

  .hover-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .hover-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    text-shadow: 0 1px 6px rgba(0,0,0,0.8);
  }

  .hover-count {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--signal-yellow);
    letter-spacing: 0.04em;
  }

  /* Corner Badge */
  .media-corner-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(16, 16, 16, 0.88);
    color: var(--signal-yellow);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--signal-yellow);
    pointer-events: none;
  }

  /* Heading Block */
  .project-heading-block {
    margin-bottom: 0.75rem;
  }

  .project-title {
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .project-sub {
    font-family: var(--font-subhead);
    font-size: 0.95rem;
    font-weight: 600;
    color: #555555;
  }

  .project-desc {
    font-size: 0.92rem;
    color: #2D3139;
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .project-highlights-box {
    background: #F8F9FB;
    border: 1px solid var(--ink);
    padding: 0.75rem 0.85rem;
    margin-bottom: 1.25rem;
  }

  .highlights-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: #666666;
    display: block;
    margin-bottom: 0.4rem;
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.84rem;
    color: #333333;
    line-height: 1.4;
  }

  .check-icon {
    color: #059669;
    font-weight: 900;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .project-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 2px dashed rgba(16, 16, 16, 0.2);
  }

  .btn-gallery {
    background: var(--ink);
    color: var(--signal-yellow);
    border-color: var(--ink);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .btn-gallery:hover {
    background: var(--signal-yellow);
    color: var(--ink);
  }
</style>
