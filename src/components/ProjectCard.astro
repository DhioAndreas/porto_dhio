---
// ProjectCard.astro — Neubrutalism Card
interface GalleryItem {
  src: string;
  caption?: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  category: string;
  featured?: boolean;
  image?: string;
  gallery?: GalleryItem[];
  tags: string[];
  highlights?: string[];
  metrics?: string;
  github?: string;
  demo?: string;
  index: number;
}

const {
  title,
  subtitle,
  description,
  category,
  featured = false,
  image,
  gallery = [],
  tags,
  highlights = [],
  metrics,
  github,
  demo,
  index,
} = Astro.props;

const galleryItems = gallery.map((g) =>
  typeof g === "string"
    ? { src: g, caption: "" }
    : { src: g.src ?? g, caption: g.caption ?? "" }
);

const catColor: Record<string, string> = {
  "AI":                   "tag-red",
  "AI & Mobile App":      "tag-red",
  "AI & Web Application": "tag-red",
  "Web":                  "tag-blue",
  "Mobile":               "tag-purple",
  "Database":             "tag-green",
};
const catTag = catColor[category] ?? "tag-dark";
const cardId  = `proj-card-${index}`;
const galleryJson = JSON.stringify(galleryItems);
---

<article
  class:list={["proj-card nb-card", { "proj-featured": featured }]}
  id={cardId}
>
  <!-- Thumbnail image -->
  {image && (
    <div class="proj-img-wrap">
      <img
        src={image}
        alt={`Screenshot ${title}`}
        class="proj-img"
        loading="lazy"
        decoding="async"
      />
      {featured && <div class="featured-stamp">★ Featured</div>}
    </div>
  )}

  <!-- Header -->
  <div class="proj-body">
    <div class="proj-header">
      <span class={`tag ${catTag}`}>{category}</span>
      {featured && <span class="tag tag-yellow">Top Pick</span>}
    </div>

    <h3 class="proj-title">{title}</h3>
    <p class="proj-subtitle">{subtitle}</p>
    <p class="proj-desc">{description}</p>

    <!-- Highlights -->
    {highlights.length > 0 && (
      <ul class="proj-highlights">
        {highlights.slice(0, 3).map((h) => <li>{h}</li>)}
      </ul>
    )}

    <!-- Metrics badge -->
    {metrics && (
      <div class="proj-metrics-badge">
        <span class="mono">⚡ {metrics}</span>
      </div>
    )}

    <!-- Tech tags -->
    <div class="proj-tags">
      {tags.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
      {tags.length > 5 && <span class="tag">+{tags.length - 5}</span>}
    </div>

    <!-- Actions -->
    <div class="proj-actions">
      {galleryItems.length > 0 && (
        <button
          class="btn btn-dark btn-sm open-gallery-btn"
          data-card-id={cardId}
          data-gallery={galleryJson}
          data-title={title}
          type="button"
          aria-label="Buka galeri foto proyek"
        >
          📷 Galeri ({galleryItems.length})
        </button>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener" class="btn btn-sm">
          ↗ GitHub
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener" class="btn btn-yellow btn-sm">
          ↗ Demo
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .proj-card {
    display: flex;
    flex-direction: column;
    background: var(--paper-card);
    border: var(--border);
    box-shadow: var(--shadow);
    transition: transform 0.12s, box-shadow 0.12s;
    overflow: hidden;
  }

  .proj-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  .proj-featured {
    border-color: var(--ink);
    box-shadow: 6px 6px 0 var(--yellow);
  }
  .proj-featured:hover {
    box-shadow: 8px 8px 0 var(--yellow);
  }

  /* Thumbnail */
  .proj-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: var(--border);
    background: #e8e8e8;
    flex-shrink: 0;
  }

  .proj-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .proj-card:hover .proj-img {
    transform: scale(1.05);
  }

  .featured-stamp {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-bottom: var(--border-2);
    border-right: var(--border-2);
  }

  /* Body */
  .proj-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.35rem;
    flex: 1;
  }

  .proj-header {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .proj-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.15;
  }

  .proj-subtitle {
    font-size: 0.78rem;
    color: #777;
    font-weight: 600;
    font-family: var(--font-sub);
    margin-top: -0.3rem;
  }

  .proj-desc {
    font-size: 0.85rem;
    line-height: 1.7;
    color: #444;
  }

  /* Highlights */
  .proj-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .proj-highlights li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.8rem;
    color: #444;
    line-height: 1.5;
  }

  .proj-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
    font-size: 0.72rem;
    top: 1px;
  }

  /* Metrics */
  .proj-metrics-badge {
    background: var(--yellow-light);
    border: var(--border-2);
    padding: 0.35rem 0.65rem;
    box-shadow: 2px 2px 0 var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Tags */
  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 0.65rem;
    border-top: var(--border-2);
    margin-top: auto;
  }

  /* Actions */
  .proj-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
