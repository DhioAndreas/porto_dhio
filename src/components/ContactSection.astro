---
// ContactSection.astro — Neubrutalism Contact
---

<section id="contact" class="section contact-section">
  <div class="container">

    <div class="section-hdr">
      <div class="section-label">
        <span class="mono">// 07 — Kontak</span>
      </div>
      <h2 class="section-title">Mari Berkolaborasi</h2>
      <p class="section-subtitle">Terbuka untuk peluang kerja, freelance, atau sekadar diskusi teknologi.</p>
    </div>

    <div class="contact-bento">

      <!-- CTA Tile -->
      <div class="ct-tile ct-main" id="contact-main">
        <p class="ct-headline">
          Punya proyek menarik? <br />
          <strong>Let's talk.</strong>
        </p>
        <div class="ct-links">
          <a
            href="mailto:dhioandreas4@gmail.com"
            class="btn btn-dark"
            id="contact-email-btn"
          >
            ✉️ dhioandreas4@gmail.com
          </a>
          <a
            href="https://wa.me/6289638540018"
            target="_blank"
            rel="noopener"
            class="btn btn-green"
            id="contact-wa-btn"
          >
            💬 WhatsApp
          </a>
        </div>
      </div>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/dhioandreas"
        target="_blank"
        rel="noopener"
        class="ct-tile ct-social ct-linkedin"
        id="contact-linkedin"
      >
        <span class="social-icon">in</span>
        <div>
          <span class="social-label">LinkedIn</span>
          <span class="social-handle">/dhioandreas</span>
        </div>
        <span class="social-arrow">↗</span>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/DhioAndreas"
        target="_blank"
        rel="noopener"
        class="ct-tile ct-social ct-github"
        id="contact-github"
      >
        <span class="social-icon gh-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </span>
        <div>
          <span class="social-label">GitHub</span>
          <span class="social-handle">/DhioAndreas</span>
        </div>
        <span class="social-arrow">↗</span>
      </a>

      <!-- Location tile -->
      <div class="ct-tile ct-loc" id="contact-location">
        <span class="loc-big">📍</span>
        <div>
          <strong class="loc-city-text">Jakarta, Indonesia</strong>
          <span class="loc-note">WFH / WFO · Ready to relocate</span>
        </div>
      </div>

      <!-- Download CV tile -->
      <a
        href="/cv_dhio.pdf"
        target="_blank"
        rel="noopener"
        download
        class="ct-tile ct-cv"
        id="contact-cv"
      >
        <span class="cv-icon">📄</span>
        <div>
          <strong>Download CV</strong>
          <span class="cv-note">PDF · Up-to-date 2025</span>
        </div>
        <span class="cv-arrow">↓</span>
      </a>

    </div>
  </div>
</section>

<style>
  .contact-section { background: transparent; }

  .section-hdr { margin-bottom: 2rem; }

  .section-label {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--red);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    border: var(--border-2);
    box-shadow: var(--shadow-sm);
    margin-bottom: 0.6rem;
  }

  .section-title { font-size: 2.2rem; }
  @media (min-width: 768px) { .section-title { font-size: 2.8rem; } }

  .section-subtitle {
    font-size: 0.95rem;
    color: #555;
    margin-top: 0.4rem;
    font-weight: 500;
  }

  /* ── Bento ── */
  .contact-bento {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
    grid-template-areas:
      "main"
      "linkedin"
      "github"
      "loc"
      "cv";
  }

  @media (min-width: 640px) {
    .contact-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "main    main"
        "linkedin github"
        "loc     cv";
    }
  }

  @media (min-width: 960px) {
    .contact-bento {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-areas:
        "main linkedin github"
        "main loc      cv";
    }
  }

  /* Tile base */
  .ct-tile {
    background: var(--paper-card);
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 1.5rem;
    transition: transform 0.1s, box-shadow 0.1s;
    text-decoration: none;
    color: var(--ink);
    display: flex;
  }

  .ct-tile:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  /* Main CTA */
  .ct-main {
    grid-area: main;
    flex-direction: column;
    gap: 1.5rem;
    justify-content: center;
    background: var(--ink);
    color: #fff;
  }

  .ct-headline {
    font-family: var(--font-sub);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
  }

  .ct-headline strong {
    color: var(--yellow);
    font-family: var(--font-display);
    font-size: 2rem;
    display: block;
  }

  .ct-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Social tiles */
  .ct-social {
    align-items: center;
    gap: 1rem;
  }

  .ct-linkedin { grid-area: linkedin; background: var(--blue-light); }
  .ct-github   { grid-area: github; background: var(--paper); }

  .social-icon {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: #fff;
    border: var(--border-2);
    flex-shrink: 0;
  }

  .gh-icon {
    font-size: 1rem;
  }

  .social-label {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  .social-handle {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #666;
  }

  .social-arrow {
    margin-left: auto;
    font-size: 1.4rem;
    font-weight: 700;
    color: #999;
  }

  /* Location */
  .ct-loc {
    grid-area: loc;
    align-items: center;
    gap: 0.85rem;
    background: var(--red-light);
  }

  .loc-big { font-size: 2rem; flex-shrink: 0; }

  .loc-city-text {
    display: block;
    font-family: var(--font-sub);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .loc-note {
    display: block;
    font-size: 0.75rem;
    color: #666;
    margin-top: 0.2rem;
  }

  /* CV */
  .ct-cv {
    grid-area: cv;
    align-items: center;
    gap: 1rem;
    background: var(--yellow);
    cursor: pointer;
  }

  .cv-icon { font-size: 2rem; flex-shrink: 0; }

  .ct-cv strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  .cv-note {
    display: block;
    font-size: 0.72rem;
    color: #555;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
  }

  .cv-arrow {
    margin-left: auto;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
  }
</style>
