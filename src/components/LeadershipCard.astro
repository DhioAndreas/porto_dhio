---
// LeadershipCard.astro — Neubrutalism
interface Props {
  role: string;
  org: string;
  period: string;
  category: string;
  bullets: string[];
  index: number;
}

const { role, org, period, category, bullets, index } = Astro.props;

const catColors: Record<string, string> = {
  Kepemimpinan:   "tag-blue",
  Humas:          "tag-yellow",
  Administrasi:   "tag-green",
  Demokrasi:      "tag-purple",
};
const catTag = catColors[category] ?? "tag-dark";

const accents = ["var(--yellow)", "var(--blue-light)", "var(--green-light)", "#F5F0FF"];
const accentBg = accents[index % accents.length];
---

<article class="leadership-card nb-card nb-card-hover" id={`lead-card-${index}`} style={`--accent-bg: ${accentBg};`}>
  <div class="lead-top">
    <span class={`tag ${catTag}`}>{category}</span>
    <span class="lead-period mono">{period}</span>
  </div>

  <h3 class="lead-role">{role}</h3>
  <p class="lead-org">{org}</p>

  {bullets.length > 0 && (
    <ul class="lead-bullets">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  )}
</article>

<style>
  .leadership-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--accent-bg, var(--paper-card));
  }

  .lead-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lead-period {
    font-size: 0.72rem;
    font-weight: 700;
    color: #666;
    text-transform: uppercase;
  }

  .lead-role {
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  .lead-org {
    font-family: var(--font-sub);
    font-size: 0.85rem;
    font-weight: 700;
    color: #555;
    padding-left: 0.65rem;
    border-left: 3px solid var(--ink);
  }

  .lead-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .lead-bullets li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: #333;
    line-height: 1.5;
  }

  .lead-bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-size: 0.72rem;
    top: 2px;
  }
</style>
