---
// ExperienceCard.astro — Neubrutalism
interface Props {
  role: string;
  org: string;
  period: string;
  location: string;
  badge: string;
  bullets: string[];
  tech: string[];
  index: number;
}

const { role, org, period, location, badge, bullets, tech, index } = Astro.props;

const badgeColors = ["tag-blue", "tag-yellow", "tag-green", "tag-red", "tag-purple"];
const badgeClass = badgeColors[index % badgeColors.length];
---

<article class="exp-card nb-card nb-card-hover" id={`exp-card-${index}`}>
  <div class="exp-header">
    <div class="exp-meta-left">
      <span class={`tag ${badgeClass}`}>{badge}</span>
      <h3 class="exp-role">{role}</h3>
    </div>
    <div class="exp-meta-right">
      <span class="exp-period mono">{period}</span>
      <span class="exp-location">{location}</span>
    </div>
  </div>

  <div class="exp-org-bar">
    <span class="exp-org">{org}</span>
  </div>

  <ul class="exp-bullets">
    {bullets.map((b) => (
      <li>{b}</li>
    ))}
  </ul>

  {tech.length > 0 && (
    <div class="exp-tech">
      {tech.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}
</article>

<style>
  .exp-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .exp-meta-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .exp-role {
    font-family: var(--font-display);
    font-size: 1.2rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  .exp-meta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
  }

  .exp-period {
    font-size: 0.75rem;
    font-weight: 700;
    color: #666;
    text-transform: uppercase;
  }

  .exp-location {
    font-size: 0.75rem;
    color: #888;
  }

  .exp-org-bar {
    border-left: 4px solid var(--yellow);
    padding-left: 0.75rem;
  }

  .exp-org {
    font-family: var(--font-sub);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .exp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .exp-bullets li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.88rem;
    color: #333;
    line-height: 1.55;
  }

  .exp-bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-size: 0.75rem;
    top: 2px;
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: var(--border-2);
  }
</style>
