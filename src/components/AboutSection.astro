---
// AboutSection.astro — Neubrutalism About Bento
---

<section id="about" class="section about-section">
  <div class="container">

    <!-- Section header -->
    <div class="section-hdr">
      <div class="section-label">
        <span class="mono">// 01 — Tentang Saya</span>
      </div>
      <h2 class="section-title">About Me</h2>
    </div>

    <!-- Bento Grid -->
    <div class="about-bento">

      <!-- Main Bio Card -->
      <div class="ab-tile ab-bio" id="about-bio">
        <h3 class="bio-heading">
          Saya membangun <em>sistem digital</em> yang benar-benar bekerja.
        </h3>
        <p>
          Saya Dhio Andreas Gemilang — Sarjana Teknologi Informasi dari Universitas Darma Persada (IPK 3.34).
          Perpaduan latar belakang elektronika dari SMKN 5 Jakarta dan studi formal Teknologi Informasi
          membentuk cara pandang saya yang <strong>berorientasi sistem</strong>:
          saya tidak hanya menulis kode — saya merancang alur, menganalisis masalah,
          dan membangun solusi yang bisa diandalkan.
        </p>
        <p>
          Berpengalaman sebagai <strong>Full-Stack Developer</strong> (Laravel, React, Flutter, Python)
          dan <strong>Data Annotator ML</strong> di KUPU ID.
          Proyek saya mencakup sistem deteksi gigi berbasis CNN, chatbot LLM interaktif,
          hingga platform reservasi tiket bus.
        </p>
        <p>
          Di luar kode, saya aktif dalam organisasi kemasyarakatan sebagai Ketua SGI,
          anggota KPPS, dan pernah mengemban peran Sekretaris RT.
          Saya percaya tanggung jawab publik membentuk karakter profesional.
        </p>
      </div>

      <!-- Principles card -->
      <div class="ab-tile ab-principles" id="about-principles">
        <h4 class="tile-label mono">// Prinsip Kerja</h4>
        <ul class="principle-list">
          <li>
            <span class="pr-number">01</span>
            <span><strong>Clarity First</strong> — Kode bersih lebih berharga dari kode pintar yang sulit dibaca.</span>
          </li>
          <li>
            <span class="pr-number">02</span>
            <span><strong>Own The Problem</strong> — Pahami dulu masalahnya sebelum menulis baris pertama.</span>
          </li>
          <li>
            <span class="pr-number">03</span>
            <span><strong>Ship, Then Iterate</strong> — Lebih baik versi 1 berjalan daripada versi sempurna yang tak pernah selesai.</span>
          </li>
          <li>
            <span class="pr-number">04</span>
            <span><strong>Learn Out Loud</strong> — Berbagi pengetahuan mempercepat pertumbuhan tim.</span>
          </li>
        </ul>
      </div>

      <!-- Education snap card -->
      <div class="ab-tile ab-edu" id="about-edu">
        <h4 class="tile-label mono">// Pendidikan</h4>
        <div class="edu-item">
          <div class="edu-badge-row">
            <span class="tag tag-blue">S-1 · 2021–2025</span>
          </div>
          <p class="edu-name">Sarjana Teknologi Informasi</p>
          <p class="edu-org">Universitas Darma Persada, Jakarta</p>
          <div class="gpa-row">
            <span class="gpa-box">IPK&nbsp;<strong>3.34</strong> / 4.00</span>
          </div>
        </div>
        <div class="edu-divider"></div>
        <div class="edu-item">
          <div class="edu-badge-row">
            <span class="tag">SMK · 2015–2018</span>
          </div>
          <p class="edu-name">Teknik Elektronika — Audio Video</p>
          <p class="edu-org">SMKN 5 Jakarta</p>
        </div>
      </div>

      <!-- Fun Facts tile -->
      <div class="ab-tile ab-facts" id="about-facts">
        <h4 class="tile-label mono">// Fact Sheet</h4>
        <div class="fact-grid">
          <div class="fact-item">
            <span class="fact-val">4+</span>
            <span class="fact-key">Proyek Selesai</span>
          </div>
          <div class="fact-item">
            <span class="fact-val">6+</span>
            <span class="fact-key">Sertifikasi</span>
          </div>
          <div class="fact-item">
            <span class="fact-val">9+</span>
            <span class="fact-key">Tahun Coding</span>
          </div>
          <div class="fact-item">
            <span class="fact-val">4</span>
            <span class="fact-key">Org. Diikuti</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section { background: transparent; }

  .section-hdr { margin-bottom: 2rem; }

  .section-label {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--ink);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    border: var(--border-2);
    box-shadow: var(--shadow-sm);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }

  .section-title {
    font-size: 2.2rem;
  }
  @media (min-width: 768px) { .section-title { font-size: 2.8rem; } }

  /* ── Bento ── */
  .about-bento {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
    grid-template-areas:
      "bio"
      "principles"
      "edu"
      "facts";
  }

  @media (min-width: 768px) {
    .about-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "bio        bio"
        "principles edu"
        "facts      edu";
    }
  }

  @media (min-width: 1024px) {
    .about-bento {
      grid-template-columns: 1fr 320px 240px;
      grid-template-areas:
        "bio bio   edu"
        "bio bio   edu"
        "principles principles facts";
    }
  }

  /* ── Tile Base ── */
  .ab-tile {
    background: var(--paper-card);
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 1.75rem;
  }

  /* Bio */
  .ab-bio { grid-area: bio; }

  .bio-heading {
    font-family: var(--font-sub);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 1rem;
    text-transform: none;
    color: var(--ink);
  }

  .bio-heading em {
    font-style: italic;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    font-style: normal;
  }

  .ab-bio p {
    font-size: 0.93rem;
    line-height: 1.75;
    color: #333;
    margin-bottom: 0.85rem;
  }
  .ab-bio p:last-child { margin-bottom: 0; }
  .ab-bio strong { color: var(--ink); font-weight: 700; }

  /* Principles */
  .ab-principles { grid-area: principles; }

  .tile-label {
    font-size: 0.68rem;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    display: block;
  }

  .principle-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .principle-list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    font-size: 0.87rem;
    line-height: 1.5;
    color: #333;
  }

  .pr-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--blue);
    flex-shrink: 0;
    margin-top: 2px;
    background: var(--blue-light);
    border: var(--border-2);
    padding: 0.1rem 0.35rem;
  }

  /* Education */
  .ab-edu { grid-area: edu; }

  .edu-badge-row { margin-bottom: 0.5rem; }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 0;
  }

  .edu-name {
    font-family: var(--font-sub);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .edu-org {
    font-size: 0.82rem;
    color: #666;
  }

  .gpa-row { margin-top: 0.4rem; }

  .gpa-box {
    display: inline-block;
    background: var(--yellow);
    border: var(--border-2);
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .gpa-box strong { color: var(--ink); }

  .edu-divider {
    height: 3px;
    background: var(--ink);
    margin: 0.25rem 0;
  }

  /* Facts */
  .ab-facts { grid-area: facts; }

  .fact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 0.5rem;
    border: var(--border-2);
    background: var(--yellow-light);
    text-align: center;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .fact-val {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--ink);
    line-height: 1;
  }

  .fact-key {
    font-size: 0.68rem;
    font-weight: 600;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.25rem;
  }
</style>
