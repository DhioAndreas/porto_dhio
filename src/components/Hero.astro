---
// Hero.astro — Premium Neubrutalism × Bento Grid
---

<section id="hero" class="hero-wrap">

  <!-- Marquee strip above hero -->
  <div class="marquee-strip hero-marquee">
    <div class="marquee-track">
      <span class="marquee-item">Full-Stack Developer</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Laravel · React · Flutter</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Cisco CCNAv7 Certified</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">AI & Computer Vision</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Open to Work</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Full-Stack Developer</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Laravel · React · Flutter</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Cisco CCNAv7 Certified</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">AI & Computer Vision</span>
      <span class="marquee-sep">✦</span>
      <span class="marquee-item">Open to Work</span>
      <span class="marquee-sep">✦</span>
    </div>
  </div>

  <div class="container">
    <div class="hero-bento">

      <!-- ╔═══════════════╗
           ║  A: PHOTO    ║
           ╚═══════════════╝ -->
      <div class="h-tile h-photo" id="hero-photo">
        <img
          src="/images/pas_foto.jpg"
          alt="Dhio Andreas Gemilang"
          class="hero-img"
          loading="eager"
          decoding="async"
        />
        <div class="photo-tag">
          <span class="pulse-dot"></span>
          <span>Open to Work</span>
        </div>
      </div>

      <!-- ╔═══════════════╗
           ║  B: NAME     ║
           ╚═══════════════╝ -->
      <div class="h-tile h-name nb-dark" id="hero-name">
        <span class="h-eyebrow mono">// 01 — Portfolio 2025</span>
        <h1 class="h-nameh1">
          <span class="h-first">Dhio</span>
          <span class="h-mid">Andreas</span>
          <span class="h-last">Gemilang</span>
        </h1>
        <p class="h-cred mono">S.Kom &nbsp;·&nbsp; Cisco CCNAv7 &nbsp;·&nbsp; IPK 3.34</p>
      </div>

      <!-- ╔═══════════════╗
           ║  C: BIO      ║
           ╚═══════════════╝ -->
      <div class="h-tile h-bio" id="hero-bio">
        <p class="h-bio-text">
          Sarjana Teknologi Informasi dari Universitas Darma Persada —
          membangun <strong>web, mobile &amp; AI</strong> yang benar-benar berfungsi.
          <br/><br/>
          Berpengalaman sebagai <strong>Full-Stack Developer</strong> (Laravel · React · Flutter)
          dan <strong>ML Data Annotator</strong> di KUPU ID. Proyek mencakup deteksi gigi CNN,
          chatbot LLM, platform reservasi, dan portal klien.
        </p>
        <div class="h-ctas">
          <a href="#projects" class="btn btn-dark" id="hero-cta-proj">Lihat Proyek ↓</a>
          <a href="#contact"  class="btn btn-yellow" id="hero-cta-contact">Kontak Saya</a>
          <a href="/cv_dhio.pdf" target="_blank" rel="noopener" class="btn btn-sm" id="hero-cta-cv">↓ CV PDF</a>
        </div>
      </div>

      <!-- ╔═══════════════╗
           ║  D: IPK STAT ║
           ╚═══════════════╝ -->
      <div class="h-tile h-stat h-stat-ipk" id="hero-ipk">
        <span class="stat-eyebrow">IPK Kumulatif</span>
        <span class="stat-big">3.34</span>
        <span class="stat-note">Sangat Memuaskan · S-1 TI</span>
      </div>

      <!-- ╔═══════════════╗
           ║  E: CCNA     ║
           ╚═══════════════╝ -->
      <div class="h-tile h-stat h-stat-ccna" id="hero-ccna">
        <span class="stat-eyebrow">Sertifikasi Cisco</span>
        <span class="stat-big ccna-text">CCNA<span class="ccna-v">v7</span></span>
        <span class="stat-note">Network Associate</span>
      </div>

      <!-- ╔═══════════════╗
           ║  F: PROJECTS ║
           ╚═══════════════╝ -->
      <div class="h-tile h-stat h-stat-proj" id="hero-proj">
        <span class="stat-eyebrow">Total Proyek</span>
        <span class="stat-big">4+</span>
        <span class="stat-note">AI · Web · Mobile</span>
      </div>

      <!-- ╔═══════════════╗
           ║  G: LOCATION ║
           ╚═══════════════╝ -->
      <div class="h-tile h-location" id="hero-loc">
        <span class="loc-pin">📍</span>
        <div>
          <strong class="loc-city">Jakarta</strong>
          <span class="loc-country mono">Indonesia · WFH / WFO</span>
        </div>
      </div>

      <!-- ╔═══════════════╗
           ║  H: STACK    ║
           ╚═══════════════╝ -->
      <div class="h-tile h-stack" id="hero-stack">
        <span class="stack-label mono">// Tech Stack</span>
        <div class="stack-wrap">
          <span class="tag tag-blue">Laravel</span>
          <span class="tag tag-yellow">React</span>
          <span class="tag tag-dark">Python</span>
          <span class="tag tag-green">Flutter</span>
          <span class="tag tag-purple">MySQL</span>
          <span class="tag">Cisco</span>
          <span class="tag tag-red">AI/ML</span>
          <span class="tag">Git</span>
        </div>
      </div>

    </div><!-- /.hero-bento -->
  </div>
</section>

<style>
/* ── Section wrapper ── */
.hero-wrap {
  padding-top: var(--nav-h);
  padding-bottom: 2rem;
}

.hero-marquee {
  margin-bottom: 1.5rem;
}

/* ══════════════════════════════════
   BENTO GRID
   ══════════════════════════════════ */
.hero-bento {
  display: grid;
  gap: var(--gap);

  /* Mobile: 2 col */
  grid-template-columns: 1fr 1fr;
  grid-template-areas:
    "photo  photo"
    "name   name"
    "bio    bio"
    "ipk    ccna"
    "proj   loc"
    "stack  stack";
}

/* Tablet ≥ 640px */
@media (min-width: 640px) {
  .hero-bento {
    grid-template-columns: repeat(4, 1fr);
    grid-template-areas:
      "photo  photo  name   name"
      "photo  photo  bio    bio"
      "photo  photo  ipk    ccna"
      "photo  photo  proj   loc"
      "stack  stack  stack  stack";
  }
}

/* Desktop ≥ 960px */
@media (min-width: 960px) {
  .hero-bento {
    grid-template-columns: 260px 1fr 155px 155px;
    grid-template-areas:
      "photo  name  name  name"
      "photo  bio   bio   bio"
      "photo  ipk   ccna  proj"
      "photo  loc   stack stack";
  }
}

/* ── Shared tile base ── */
.h-tile {
  border: var(--border);
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

/* ══ A: PHOTO ══ */
.h-photo {
  grid-area: photo;
  padding: 0;
  background: #111;
  display: flex;
  flex-direction: column;
  min-height: 300px;
}
@media (min-width: 640px) { .h-photo { min-height: 480px; } }
@media (min-width: 960px) { .h-photo { min-height: 0; height: 100%; } }

.hero-img {
  width: 100%;
  flex: 1;
  object-fit: cover;
  object-position: center 10%;
  display: block;
  transition: transform 0.5s ease;
  min-height: 280px;
}
@media (min-width: 640px) { .hero-img { min-height: 420px; } }
.h-photo:hover .hero-img { transform: scale(1.04); }

.photo-tag {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--green);
  color: #fff;
  font-family: var(--font-sub);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.5rem 1rem;
  border-top: var(--border);
  flex-shrink: 0;
}

.pulse-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
  animation: pdot 1.8s ease-in-out infinite;
}
@keyframes pdot {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:0.35; transform:scale(1.5); }
}

/* ══ B: NAME ══ */
.h-name {
  grid-area: name;
  background: var(--ink);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.4rem 1.5rem;
  min-height: 140px;
  gap: 0.5rem;
}

.h-eyebrow {
  font-size: 0.62rem;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.h-nameh1 {
  display: flex;
  flex-direction: column;
  color: #fff;
  font-size: clamp(2rem, 5.5vw, 3.6rem);
  line-height: 0.92;
  letter-spacing: -0.04em;
  gap: 0;
}

.h-first  { color: #fff; }
.h-mid    { color: var(--yellow); }
.h-last   { color: #fff; }

.h-cred {
  font-size: 0.63rem;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 0.4rem;
}

/* ══ C: BIO ══ */
.h-bio {
  grid-area: bio;
  background: var(--paper-card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.1rem;
  padding: 1.4rem;
}

.h-bio-text {
  font-size: 0.9rem;
  line-height: 1.75;
  color: #444;
}
.h-bio-text strong { color: var(--ink); font-weight: 700; }

.h-ctas { display: flex; flex-wrap: wrap; gap: 0.5rem; }

/* ══ D/E/F: STATS ══ */
.h-stat {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 1.1rem 1.2rem;
  gap: 0.2rem;
}

.h-stat-ipk  { grid-area: ipk;  background: var(--yellow); }
.h-stat-ccna { grid-area: ccna; background: var(--blue); color: #fff; }
.h-stat-proj { grid-area: proj; background: var(--green); color: #fff; }

.stat-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  opacity: 0.6;
}

.stat-big {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  line-height: 1;
  letter-spacing: -0.03em;
}

.ccna-text { display: inline; }
.ccna-v { font-size: 65%; vertical-align: super; }

.stat-note {
  font-size: 0.62rem;
  opacity: 0.65;
  font-weight: 600;
  font-family: var(--font-sub);
}

/* ══ G: LOCATION ══ */
.h-location {
  grid-area: loc;
  background: var(--paper-card);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 1.1rem;
}

.loc-pin { font-size: 1.6rem; line-height: 1; flex-shrink: 0; }

.loc-city {
  display: block;
  font-family: var(--font-display);
  font-size: 1rem;
  text-transform: uppercase;
  color: var(--ink);
}

.loc-country {
  display: block;
  font-size: 0.6rem;
  color: #888;
  text-transform: uppercase;
  margin-top: 0.1rem;
}

/* ══ H: STACK ══ */
.h-stack {
  grid-area: stack;
  background: var(--paper-card);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.55rem;
  padding: 0.9rem 1.2rem;
}

.stack-label {
  font-size: 0.6rem;
  text-transform: uppercase;
  color: #999;
  font-weight: 700;
  flex-basis: 100%;
}

.stack-wrap { display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
