---
// ProjectLightbox.astro — Event Delegation + Vertical Scroll Gallery
---

<div id="project-lightbox" class="lb-root" aria-modal="true" role="dialog" hidden>
  <div class="lb-backdrop" id="lb-backdrop"></div>

  <div class="lb-panel" role="document">
    <!-- Header -->
    <div class="lb-header">
      <div class="lb-header-info">
        <span class="lb-eyebrow mono">📁 Galeri Proyek</span>
        <h2 id="lb-title" class="lb-title">—</h2>
      </div>
      <button id="lb-close" class="lb-close-btn" aria-label="Tutup galeri">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Scrollable image list -->
    <div class="lb-body" id="lb-body">
      <div id="lb-list" class="lb-list"></div>
    </div>

    <!-- Footer -->
    <div class="lb-footer">
      <span id="lb-count" class="lb-count mono">0 foto</span>
      <span class="lb-hint">Scroll ↓ untuk lihat semua</span>
    </div>
  </div>
</div>

<script>
  interface GItem { src: string; caption: string; }

  const root    = document.getElementById('project-lightbox')!;
  const backdrop = document.getElementById('lb-backdrop')!;
  const titleEl  = document.getElementById('lb-title')!;
  const listEl   = document.getElementById('lb-list')!;
  const countEl  = document.getElementById('lb-count')!;
  const bodyEl   = document.getElementById('lb-body')!;

  /* ─── Open ─── */
  function openGallery(title: string, items: GItem[]) {
    if (!items.length) return;

    titleEl.textContent = title;
    countEl.textContent = `${items.length} foto`;

    listEl.innerHTML = items.map((item, i) => `
      <div class="lb-item">
        <div class="lb-item-label">
          <span class="lb-item-num">${String(i + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}</span>
        </div>
        <div class="lb-item-img-box">
          <img
            src="${item.src}"
            alt="${item.caption || `Foto ${i + 1}`}"
            class="lb-item-img"
            loading="${i < 2 ? 'eager' : 'lazy'}"
          />
        </div>
        ${item.caption ? `
          <div class="lb-item-caption">
            <span class="lb-cap-badge">${String(i + 1).padStart(2, '0')}</span>
            <p class="lb-cap-text">${item.caption}</p>
          </div>
        ` : ''}
      </div>
    `).join('');

    bodyEl.scrollTop = 0;
    root.removeAttribute('hidden');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add('open'));
    });
    document.body.style.overflow = 'hidden';
    document.getElementById('lb-close')?.focus();
  }

  /* ─── Close ─── */
  function closeGallery() {
    root.classList.remove('open');
    setTimeout(() => {
      root.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }, 300);
  }

  /* ─── Event Delegation: catch ALL gallery buttons on the page ─── */
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('.open-gallery-btn');
    if (!btn) return;

    const raw   = btn.dataset.gallery || '[]';
    const title = btn.dataset.title || 'Galeri';
    let items: GItem[] = [];

    try {
      const parsed = JSON.parse(raw);
      items = parsed.map((p: GItem | string) =>
        typeof p === 'string'
          ? { src: p, caption: '' }
          : { src: p.src, caption: p.caption ?? '' }
      );
    } catch { items = []; }

    if (items.length) openGallery(title, items);
  });

  /* ─── Controls ─── */
  backdrop.addEventListener('click', closeGallery);
  document.getElementById('lb-close')!.addEventListener('click', closeGallery);

  document.addEventListener('keydown', (e) => {
    if (!root.hasAttribute('hidden') && e.key === 'Escape') closeGallery();
  });
</script>

<style>
  /* ── Overlay ── */
  .lb-root {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .lb-root[hidden] { display: none !important; }
  .lb-root.open    { opacity: 1; pointer-events: auto; }

  /* Backdrop */
  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(3px);
    cursor: pointer;
  }

  /* ── Drawer Panel ── */
  .lb-panel {
    position: relative;
    z-index: 1;
    width: min(560px, 100vw);
    height: 100%;
    background: var(--paper-card, #fff);
    border-left: 4px solid var(--ink, #0a0a0a);
    display: flex;
    flex-direction: column;
    transform: translateX(110%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .lb-root.open .lb-panel { transform: translateX(0); }

  /* Mobile: slide from bottom */
  @media (max-width: 600px) {
    .lb-root { align-items: flex-end; justify-content: stretch; }
    .lb-panel {
      width: 100%;
      height: 92dvh;
      border-left: none;
      border-top: 4px solid var(--ink, #0a0a0a);
      transform: translateY(110%);
    }
    .lb-root.open .lb-panel { transform: translateY(0); }
  }

  /* ── Header ── */
  .lb-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.35rem;
    background: var(--yellow, #FFD400);
    border-bottom: 3px solid var(--ink, #0a0a0a);
    flex-shrink: 0;
  }

  .lb-header-info { flex: 1; min-width: 0; }

  .lb-eyebrow {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(0,0,0,0.5);
    margin-bottom: 0.2rem;
  }

  .lb-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    color: var(--ink, #0a0a0a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .lb-close-btn {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background: var(--ink, #0a0a0a);
    color: #fff;
    border: 2px solid var(--ink, #0a0a0a);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.1s;
    box-shadow: 3px 3px 0 rgba(0,0,0,0.25);
  }
  .lb-close-btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 rgba(0,0,0,0.25);
  }

  /* ── Scrollable Body ── */
  .lb-body {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--ink, #0a0a0a) transparent;
  }
  .lb-body::-webkit-scrollbar { width: 5px; }
  .lb-body::-webkit-scrollbar-thumb { background: var(--ink, #0a0a0a); }

  /* ── Image List ── */
  .lb-list {
    display: flex;
    flex-direction: column;
  }

  /* Individual item */
  .lb-item {
    border-bottom: 3px solid var(--ink, #0a0a0a);
  }
  .lb-item:last-child { border-bottom: none; }

  /* Item label bar */
  .lb-item-label {
    padding: 0.4rem 1.25rem;
    background: var(--paper, #EDEDEC);
    border-bottom: 2px solid var(--ink, #0a0a0a);
  }

  .lb-item-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Image */
  .lb-item-img-box {
    background: #111;
    line-height: 0;
    overflow: hidden;
  }

  .lb-item-img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    display: block;
    transition: transform 0.3s ease;
  }

  .lb-item:hover .lb-item-img { transform: scale(1.02); }

  /* Caption */
  .lb-item-caption {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.9rem 1.25rem;
    background: var(--paper-card, #fff);
    border-top: 2px solid var(--ink, #0a0a0a);
  }

  .lb-cap-badge {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
    background: var(--blue, #1D4ED8);
    border: 2px solid var(--ink, #0a0a0a);
    padding: 0.15rem 0.45rem;
    line-height: 1.4;
    box-shadow: 2px 2px 0 var(--ink, #0a0a0a);
    margin-top: 1px;
  }

  .lb-cap-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    line-height: 1.65;
    color: #333;
    font-weight: 500;
  }

  /* ── Footer ── */
  .lb-footer {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.35rem;
    border-top: 3px solid var(--ink, #0a0a0a);
    background: var(--paper, #EDEDEC);
  }

  .lb-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink, #0a0a0a);
    text-transform: uppercase;
  }

  .lb-hint {
    font-size: 0.7rem;
    color: #888;
    font-family: 'Inter', sans-serif;
  }
</style>
