---

<!-- Global Project Lightbox Modal -->
<div id="project-lightbox" class="lightbox-overlay" aria-modal="true" role="dialog" aria-label="Galeri Proyek" hidden>
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>

  <div class="lightbox-panel">
    <!-- Header -->
    <div class="lb-header">
      <div class="lb-header-left">
        <span class="lb-dot"></span>
        <span id="lb-project-title" class="lb-title mono">PROJECT</span>
      </div>
      <div class="lb-header-right">
        <span id="lb-counter" class="lb-counter mono">1 / 1</span>
        <button id="lightbox-close" class="lb-close" aria-label="Tutup">✕</button>
      </div>
    </div>

    <!-- Image Stage -->
    <div class="lb-stage">
      <button class="lb-arrow lb-arrow-left" id="lb-prev" aria-label="Sebelumnya">‹</button>
      <div class="lb-img-wrap">
        <img id="lb-main-img" src="" alt="" class="lb-img" />
        <div class="lb-caption" id="lb-caption">
          <span class="lb-caption-num" id="lb-caption-idx"></span>
          <span id="lb-caption-text"></span>
        </div>
      </div>
      <button class="lb-arrow lb-arrow-right" id="lb-next" aria-label="Berikutnya">›</button>
    </div>

    <!-- Thumbnail Strip -->
    <div class="lb-thumbs" id="lb-thumb-strip"></div>
  </div>
</div>

<script>
  interface GalleryItem { src: string; caption: string; }

  let currentIdx = 0;
  let gallery: GalleryItem[] = [];

  const lb       = document.getElementById('project-lightbox')!;
  const backdrop = document.getElementById('lightbox-backdrop')!;
  const closeBtn = document.getElementById('lightbox-close')!;
  const prevBtn  = document.getElementById('lb-prev')!;
  const nextBtn  = document.getElementById('lb-next')!;
  const img      = document.getElementById('lb-main-img') as HTMLImageElement;
  const counter  = document.getElementById('lb-counter')!;
  const capIdx   = document.getElementById('lb-caption-idx')!;
  const capText  = document.getElementById('lb-caption-text')!;
  const thumbs   = document.getElementById('lb-thumb-strip')!;
  const titleEl  = document.getElementById('lb-project-title')!;

  function open(title: string, items: GalleryItem[]) {
    if (!items?.length) return;
    gallery    = items;
    currentIdx = 0;
    titleEl.textContent = title.toUpperCase().replace(/ /g, '_');

    thumbs.innerHTML = '';
    items.forEach((item, i) => {
      const btn = document.createElement('button');
      btn.className = `lb-thumb${i === 0 ? ' active' : ''}`;
      btn.setAttribute('aria-label', `Foto ${i + 1}`);
      btn.innerHTML = `<img src="${item.src}" alt="thumb ${i+1}" />`;
      btn.addEventListener('click', () => go(i));
      thumbs.appendChild(btn);
    });

    go(0);
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => closeBtn.focus(), 50);
  }

  function close() {
    lb.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  function go(i: number) {
    if (i < 0) i = gallery.length - 1;
    if (i >= gallery.length) i = 0;
    currentIdx = i;
    const item = gallery[i];

    img.style.opacity = '0';
    setTimeout(() => {
      img.src = item.src;
      img.alt = item.caption;
      img.style.opacity = '1';
    }, 100);

    counter.textContent  = `${i + 1} / ${gallery.length}`;
    capIdx.textContent   = `${i + 1}/${gallery.length}`;
    capText.textContent  = item.caption;

    thumbs.querySelectorAll<HTMLButtonElement>('.lb-thumb').forEach((t, ti) => {
      t.classList.toggle('active', ti === i);
      if (ti === i) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
  }

  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  prevBtn.addEventListener('click', () => go(currentIdx - 1));
  nextBtn.addEventListener('click', () => go(currentIdx + 1));

  document.addEventListener('keydown', (e) => {
    if (lb.hasAttribute('hidden')) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  go(currentIdx - 1);
    if (e.key === 'ArrowRight') go(currentIdx + 1);
  });

  document.addEventListener('open-project-gallery', (e: Event) => {
    const d = (e as CustomEvent).detail as { title: string; gallery: GalleryItem[] };
    open(d.title, d.gallery);
  });
</script>

<style>
  /* Overlay */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lightbox-overlay[hidden] { display: none; }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 10, 16, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  /* Panel */
  .lightbox-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    background: #13161F;
    border: 1.5px solid rgba(255, 212, 0, 0.55);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04),
      0 24px 64px rgba(0,0,0,0.7),
      0 0 40px rgba(255, 212, 0, 0.06);
    overflow: hidden;
    animation: popIn 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9) translateY(10px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* Header */
  .lb-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background: #0D0F17;
    border-bottom: 1px solid rgba(255, 212, 0, 0.2);
    gap: 0.5rem;
  }

  .lb-header-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
  }

  .lb-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00C853;
    box-shadow: 0 0 6px #00C853;
    flex-shrink: 0;
    animation: blink 2s infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .lb-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: #FFD400;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lb-header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .lb-counter {
    font-size: 0.68rem;
    color: #64748B;
    font-weight: 600;
  }

  .lb-close {
    width: 26px;
    height: 26px;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.35);
    border-radius: 3px;
    color: #F87171;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }
  .lb-close:hover {
    background: #F87171;
    color: #fff;
    border-color: #F87171;
  }

  /* Stage */
  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    background: #090B12;
  }

  .lb-img-wrap {
    flex: 1;
    position: relative;
    height: 300px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: opacity 0.12s ease;
    display: block;
  }

  /* Caption */
  .lb-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 0.75rem 0.5rem;
    background: linear-gradient(transparent, rgba(8, 10, 16, 0.95));
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: #CBD5E1;
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    pointer-events: none;
  }

  .lb-caption-num {
    color: #FFD400;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Arrow buttons */
  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 32px;
    height: 56px;
    background: rgba(13, 15, 23, 0.75);
    border: 1px solid rgba(255, 212, 0, 0.2);
    color: rgba(255, 212, 0, 0.8);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    backdrop-filter: blur(4px);
  }
  .lb-arrow:hover {
    background: rgba(255, 212, 0, 0.12);
    color: #FFD400;
    border-color: rgba(255, 212, 0, 0.5);
  }
  .lb-arrow-left  { left: 0; border-radius: 0 3px 3px 0; }
  .lb-arrow-right { right: 0; border-radius: 3px 0 0 3px; }

  /* Thumbnail Strip */
  .lb-thumbs {
    display: flex;
    gap: 4px;
    padding: 8px 10px;
    background: #0D0F17;
    border-top: 1px solid rgba(255,255,255,0.06);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,212,0,0.3) transparent;
  }

  .lb-thumb {
    flex-shrink: 0;
    width: 48px;
    height: 36px;
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 2px;
    background: #090B12;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: all 0.12s ease;
    opacity: 0.55;
  }
  .lb-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .lb-thumb:hover {
    opacity: 0.85;
    border-color: rgba(255, 212, 0, 0.5);
  }
  .lb-thumb.active {
    opacity: 1;
    border-color: #FFD400;
    box-shadow: 0 0 8px rgba(255, 212, 0, 0.3);
  }

  @media (max-width: 540px) {
    .lightbox-panel { max-width: 100%; }
    .lb-img-wrap    { height: 230px; }
    .lb-thumb       { width: 38px; height: 28px; }
  }
</style>
