---
---

<div id="project-lightbox" class="lb-root" aria-modal="true" role="dialog" hidden>
  <div class="lb-backdrop" id="lb-backdrop"></div>

  <div class="lb-shell">

    <!-- LEFT: Image Viewer -->
    <div class="lb-viewer">
      <!-- Top bar -->
      <div class="lb-viewer-bar">
        <div class="lb-dots-row">
          <span class="lb-os-dot red"></span>
          <span class="lb-os-dot yellow"></span>
          <span class="lb-os-dot green"></span>
        </div>
        <span id="lb-path" class="lb-path mono">/gallery/preview.jpg</span>
      </div>

      <!-- Image Stage -->
      <div class="lb-img-stage" id="lb-img-stage">
        <img id="lb-img" src="" alt="" class="lb-main-img" />

        <!-- Prev / Next arrows -->
        <button class="lb-nav-btn lb-nav-prev" id="lb-prev" aria-label="Sebelumnya">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="lb-nav-btn lb-nav-next" id="lb-next" aria-label="Berikutnya">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <!-- Slide index badge -->
        <div class="lb-index-badge mono" id="lb-badge">01 / 10</div>
      </div>

      <!-- Caption -->
      <div class="lb-caption-row">
        <div class="lb-caption-icon">📸</div>
        <p class="lb-caption-text" id="lb-caption">—</p>
      </div>

      <!-- Thumbnail filmstrip -->
      <div class="lb-filmstrip" id="lb-filmstrip">
        <!-- injected by JS -->
      </div>
    </div>

    <!-- RIGHT: Info Panel -->
    <div class="lb-info">
      <!-- Close button -->
      <button class="lb-close-btn" id="lb-close" aria-label="Tutup">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <div class="lb-info-body">
        <!-- Live indicator -->
        <div class="lb-live-row mono">
          <span class="lb-live-pulse"></span>
          <span class="lb-live-label">PROJECT_GALLERY</span>
        </div>

        <!-- Title -->
        <h2 class="lb-proj-title" id="lb-proj-title">—</h2>

        <!-- Divider -->
        <div class="lb-divider"></div>

        <!-- Progress indicator -->
        <div class="lb-progress-block">
          <div class="lb-progress-label mono">
            <span>SLIDE</span>
            <span id="lb-progress-num">1 / 1</span>
          </div>
          <div class="lb-progress-track">
            <div class="lb-progress-fill" id="lb-progress-fill"></div>
          </div>
        </div>

        <!-- Dot indicators -->
        <div class="lb-dot-nav" id="lb-dot-nav">
          <!-- injected by JS -->
        </div>

        <!-- Navigation buttons -->
        <div class="lb-ctrl-row">
          <button class="lb-ctrl-btn" id="lb-ctrl-prev" aria-label="Sebelumnya">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>Prev</span>
          </button>
          <button class="lb-ctrl-btn lb-ctrl-btn-accent" id="lb-ctrl-next" aria-label="Berikutnya">
            <span>Next</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>

        <!-- Footer hint -->
        <p class="lb-hint mono">ESC untuk menutup · ← → navigasi</p>
      </div>
    </div>

  </div>
</div>

<script>
  interface GalleryItem { src: string; caption: string; }

  let idx = 0;
  let items: GalleryItem[] = [];

  const lb       = document.getElementById('project-lightbox')!;
  const backdrop = document.getElementById('lb-backdrop')!;
  const imgEl    = document.getElementById('lb-img') as HTMLImageElement;
  const badge    = document.getElementById('lb-badge')!;
  const caption  = document.getElementById('lb-caption')!;
  const pathEl   = document.getElementById('lb-path')!;
  const titleEl  = document.getElementById('lb-proj-title')!;
  const progNum  = document.getElementById('lb-progress-num')!;
  const progFill = document.getElementById('lb-progress-fill') as HTMLElement;
  const dotNav   = document.getElementById('lb-dot-nav')!;
  const filmstrip= document.getElementById('lb-filmstrip')!;
  const closeBtns= [
    document.getElementById('lb-close')!,
  ];

  function pad(n: number) { return String(n).padStart(2, '0'); }

  function open(title: string, gallery: GalleryItem[]) {
    if (!gallery?.length) return;
    items = gallery;
    idx = 0;
    titleEl.textContent = title;

    // Build filmstrip thumbnails
    filmstrip.innerHTML = '';
    gallery.forEach((item, i) => {
      const btn = document.createElement('button');
      btn.className = `lb-film-thumb${i === 0 ? ' active' : ''}`;
      btn.innerHTML = `<img src="${item.src}" alt="thumb ${i+1}" />`;
      btn.addEventListener('click', () => go(i));
      filmstrip.appendChild(btn);
    });

    // Build dot nav
    dotNav.innerHTML = '';
    gallery.forEach((_, i) => {
      const d = document.createElement('button');
      d.className = `lb-dot-btn${i === 0 ? ' active' : ''}`;
      d.setAttribute('aria-label', `Slide ${i+1}`);
      d.addEventListener('click', () => go(i));
      dotNav.appendChild(d);
    });

    go(0);
    lb.removeAttribute('hidden');
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.classList.remove('is-open');
    setTimeout(() => {
      lb.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }, 220);
  }

  function go(i: number) {
    if (i < 0) i = items.length - 1;
    if (i >= items.length) i = 0;
    idx = i;
    const item = items[i];

    // Fade image
    imgEl.style.opacity = '0';
    imgEl.style.transform = 'scale(0.97)';
    setTimeout(() => {
      imgEl.src = item.src;
      imgEl.alt = item.caption;
      imgEl.style.opacity = '1';
      imgEl.style.transform = 'scale(1)';
    }, 110);

    const total = items.length;
    badge.textContent = `${pad(i + 1)} / ${pad(total)}`;
    caption.textContent = item.caption;
    pathEl.textContent = `/gallery/${item.src.split('/').pop()}`;
    progNum.textContent = `${i + 1} / ${total}`;
    progFill.style.width = `${((i + 1) / total) * 100}%`;

    // Update thumbnails
    filmstrip.querySelectorAll<HTMLButtonElement>('.lb-film-thumb').forEach((t, ti) => {
      t.classList.toggle('active', ti === i);
      if (ti === i) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });

    // Update dots
    dotNav.querySelectorAll<HTMLButtonElement>('.lb-dot-btn').forEach((d, di) => {
      d.classList.toggle('active', di === i);
    });
  }

  // Events
  closeBtns.forEach(b => b.addEventListener('click', close));
  backdrop.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', () => go(idx - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => go(idx + 1));
  document.getElementById('lb-ctrl-prev')!.addEventListener('click', () => go(idx - 1));
  document.getElementById('lb-ctrl-next')!.addEventListener('click', () => go(idx + 1));

  document.addEventListener('keydown', (e) => {
    if (lb.hasAttribute('hidden')) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  go(idx - 1);
    if (e.key === 'ArrowRight') go(idx + 1);
  });

  document.addEventListener('open-project-gallery', (e: Event) => {
    const d = (e as CustomEvent).detail as { title: string; gallery: GalleryItem[] };
    open(d.title, d.gallery);
  });
</script>

<style>
/* ─── Root overlay ───────────────────────────────────────── */
.lb-root {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
}
.lb-root[hidden] { display: none; }

.lb-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 8, 14, 0.82);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  cursor: pointer;
}

/* ─── Shell: split left + right ─────────────────────────── */
.lb-shell {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  max-width: 820px;
  max-height: 90vh;
  background: #0E1118;
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 14px;
  overflow: hidden;
  box-shadow:
    0 32px 80px rgba(0,0,0,0.75),
    0 0 0 1px rgba(255,255,255,0.03),
    inset 0 1px 0 rgba(255,255,255,0.07);
  animation: lbIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.lb-root.is-open .lb-shell { animation: lbIn 0.25s cubic-bezier(0.16, 1, 0.3, 1); }

@keyframes lbIn {
  from { opacity: 0; transform: scale(0.92) translateY(16px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* ─── LEFT: Viewer ───────────────────────────────────────── */
.lb-viewer {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-right: 1px solid rgba(255,255,255,0.07);
}

/* macOS-style top bar */
.lb-viewer-bar {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.6rem 0.85rem;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  flex-shrink: 0;
}

.lb-dots-row {
  display: flex;
  gap: 5px;
  flex-shrink: 0;
}

.lb-os-dot {
  width: 11px;
  height: 11px;
  border-radius: 50%;
}
.lb-os-dot.red    { background: #FF5F57; }
.lb-os-dot.yellow { background: #FFBD2E; }
.lb-os-dot.green  { background: #28CA41; }

.lb-path {
  font-size: 0.68rem;
  color: rgba(255,255,255,0.28);
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Image stage */
.lb-img-stage {
  position: relative;
  flex: 1 1 auto;
  background: #070910;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280px;
  overflow: hidden;
}

.lb-main-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: opacity 0.12s ease, transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  display: block;
  user-select: none;
}

/* Arrow nav */
.lb-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(14, 17, 24, 0.7);
  border: 1px solid rgba(255,255,255,0.14);
  color: rgba(255,255,255,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
  backdrop-filter: blur(6px);
}
.lb-nav-btn:hover {
  background: rgba(255,255,255,0.14);
  color: #fff;
  border-color: rgba(255,255,255,0.3);
  transform: translateY(-50%) scale(1.08);
}
.lb-nav-prev { left: 0.65rem; }
.lb-nav-next { right: 0.65rem; }

/* Slide index badge */
.lb-index-badge {
  position: absolute;
  bottom: 0.6rem;
  right: 0.6rem;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px;
  color: rgba(255,255,255,0.6);
  font-size: 0.65rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  letter-spacing: 0.06em;
  pointer-events: none;
  backdrop-filter: blur(4px);
}

/* Caption row */
.lb-caption-row {
  display: flex;
  align-items: flex-start;
  gap: 0.45rem;
  padding: 0.55rem 0.85rem;
  border-top: 1px solid rgba(255,255,255,0.05);
  flex-shrink: 0;
}

.lb-caption-icon {
  font-size: 0.78rem;
  flex-shrink: 0;
  margin-top: 1px;
}

.lb-caption-text {
  font-size: 0.73rem;
  color: rgba(255,255,255,0.45);
  line-height: 1.45;
  font-family: var(--font-mono, monospace);
}

/* Filmstrip */
.lb-filmstrip {
  display: flex;
  gap: 5px;
  padding: 0.55rem 0.75rem;
  background: rgba(0,0,0,0.2);
  border-top: 1px solid rgba(255,255,255,0.05);
  overflow-x: auto;
  flex-shrink: 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.1) transparent;
}

.lb-film-thumb {
  flex-shrink: 0;
  width: 50px;
  height: 36px;
  border-radius: 4px;
  border: 1.5px solid transparent;
  background: rgba(255,255,255,0.04);
  overflow: hidden;
  cursor: pointer;
  padding: 0;
  opacity: 0.45;
  transition: all 0.15s ease;
}
.lb-film-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  display: block;
}
.lb-film-thumb:hover {
  opacity: 0.75;
  border-color: rgba(255,255,255,0.2);
}
.lb-film-thumb.active {
  opacity: 1;
  border-color: #FFD400;
  box-shadow: 0 0 0 2px rgba(255,212,0,0.2);
}

/* ─── RIGHT: Info Panel ──────────────────────────────────── */
.lb-info {
  width: 220px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #111520 0%, #0C0E16 100%);
  padding: 1.25rem 1.1rem 1rem;
  position: relative;
}

.lb-close-btn {
  position: absolute;
  top: 0.85rem;
  right: 0.85rem;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
}
.lb-close-btn:hover {
  background: rgba(248,113,113,0.15);
  border-color: rgba(248,113,113,0.4);
  color: #F87171;
}

.lb-info-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  padding-top: 0.25rem;
}

/* Live row */
.lb-live-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.62rem;
  font-weight: 700;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.06em;
}

.lb-live-pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #00C853;
  box-shadow: 0 0 5px #00C853;
  animation: blink 2.2s infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.25; }
}

/* Project title */
.lb-proj-title {
  font-size: 1.05rem;
  line-height: 1.3;
  color: #fff;
  font-weight: 700;
  padding-right: 2rem;
  margin: 0;
}

.lb-divider {
  height: 1px;
  background: linear-gradient(90deg, rgba(255,212,0,0.35), transparent);
}

/* Progress */
.lb-progress-block {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.lb-progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.64rem;
  font-weight: 700;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.05em;
}

.lb-progress-track {
  height: 3px;
  background: rgba(255,255,255,0.08);
  border-radius: 2px;
  overflow: hidden;
}

.lb-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD400, #FFA500);
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Dot nav */
.lb-dot-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.lb-dot-btn {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
  padding: 0;
}
.lb-dot-btn:hover { background: rgba(255,255,255,0.35); }
.lb-dot-btn.active {
  background: #FFD400;
  width: 20px;
  border-radius: 4px;
  box-shadow: 0 0 6px rgba(255,212,0,0.4);
}

/* Control buttons */
.lb-ctrl-row {
  display: flex;
  gap: 0.4rem;
  margin-top: auto;
}

.lb-ctrl-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  padding: 0.5rem 0.5rem;
  font-family: var(--font-subhead, sans-serif);
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 6px;
  color: rgba(255,255,255,0.6);
  cursor: pointer;
  transition: all 0.15s ease;
}
.lb-ctrl-btn:hover {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border-color: rgba(255,255,255,0.25);
}

.lb-ctrl-btn-accent {
  background: rgba(255,212,0,0.1);
  border-color: rgba(255,212,0,0.3);
  color: #FFD400;
}
.lb-ctrl-btn-accent:hover {
  background: rgba(255,212,0,0.18);
  border-color: rgba(255,212,0,0.55);
  color: #FFD400;
}

/* Footer hint */
.lb-hint {
  font-size: 0.6rem;
  color: rgba(255,255,255,0.2);
  letter-spacing: 0.03em;
  text-align: center;
  margin: 0;
}

/* ─── Mobile responsive ──────────────────────────────────── */
@media (max-width: 640px) {
  .lb-shell {
    flex-direction: column;
    max-height: 95vh;
    border-radius: 12px;
  }
  .lb-viewer {
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .lb-info {
    width: 100%;
    padding: 0.85rem 1rem;
  }
  .lb-info-body {
    gap: 0.6rem;
  }
  .lb-proj-title {
    font-size: 0.9rem;
    padding-right: 2.5rem;
  }
  .lb-img-stage {
    min-height: 200px;
  }
}
</style>
