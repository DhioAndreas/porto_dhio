---
---

<div class="deck-container brutal-card" id="hero-deck-widget">
  <!-- Deck Header: ID & Mode Switcher -->
  <div class="deck-header">
    <div class="deck-id-badge">
      <div class="deck-avatar-box">
        <span class="avatar-letter">D</span>
        <span class="avatar-glow"></span>
      </div>
      <div class="deck-id-text">
        <div class="mono deck-name-tag">OPERATOR_ID: DAG-2025</div>
        <div class="deck-status-line">
          <span class="pulse-indicator"></span>
          <span class="status-text mono">SYSTEM: ONLINE (KLENDER-JKT)</span>
        </div>
      </div>
    </div>

    <!-- Live Audio / Signal Equalizer Bars -->
    <div class="deck-waveform" title="Live System Telemetry">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
      <span class="bar bar-4"></span>
      <span class="bar bar-5"></span>
      <span class="bar bar-6"></span>
      <span class="bar bar-7"></span>
      <span class="bar bar-8"></span>
    </div>
  </div>

  <!-- Mode Selector Tabs (Tactile Switch) -->
  <div class="deck-mode-tabs" role="tablist">
    <button class="mode-tab-btn active" data-mode="dev" role="tab" aria-selected="true">
      <span class="tab-icon">💻</span>
      <span>FULL-STACK DEV</span>
    </button>
    <button class="mode-tab-btn" data-mode="net" role="tab" aria-selected="false">
      <span class="tab-icon">🌐</span>
      <span>CISCO NET_RADAR</span>
    </button>
    <button class="mode-tab-btn" data-mode="k3" role="tab" aria-selected="false">
      <span class="tab-icon">🦺</span>
      <span>K3 & SAFETY</span>
    </button>
  </div>

  <!-- Deck Body: Dynamic Screen Panes -->
  <div class="deck-screen">
    <!-- PANE 1: FULL-STACK DEV -->
    <div class="screen-pane active" id="pane-dev">
      <div class="code-editor-mock">
        <div class="editor-topline mono">
          <span class="file-name">⚡ developer_profile.ts</span>
          <span class="tag tag-yellow tag-xs">TYPESCRIPT / REACT</span>
        </div>
        <div class="code-body mono">
          <div class="code-line"><span class="c-keyword">const</span> <span class="c-var">dhio</span>: <span class="c-type">FullStackDev</span> = &#123;</div>
          <div class="code-line indent-1"><span class="c-prop">degree</span>: <span class="c-string">"S1 TI (Univ. Darma Persada)"</span>,</div>
          <div class="code-line indent-1"><span class="c-prop">gpa</span>: <span class="c-num">3.34</span>, <span class="c-comment">// Sangat Memuaskan</span></div>
          <div class="code-line indent-1"><span class="c-prop">primaryStack</span>: [<span class="c-string">"React"</span>, <span class="c-string">"Laravel"</span>, <span class="c-string">"Python"</span>, <span class="c-string">"MySQL"</span>],</div>
          <div class="code-line indent-1"><span class="c-prop">aiAnnotation</span>: <span class="c-string">"KUPU ID Data Annotator"</span>,</div>
          <div class="code-line indent-1"><span class="c-prop">readiness</span>: <span class="c-bool">true</span> <span class="c-comment">// Ready for Hire</span></div>
          <div class="code-line">&#125;;</div>
        </div>
      </div>

      <!-- Quick Interactive Tech Badges -->
      <div class="interactive-tech-strip">
        <span class="tech-chip chip-yellow">Laravel + React</span>
        <span class="tech-chip chip-blue">Python & ML</span>
        <span class="tech-chip chip-green">Flutter Mobile</span>
        <span class="tech-chip chip-dark">REST API & SQL</span>
      </div>
    </div>

    <!-- PANE 2: CISCO NETWORK TOPOLOGY & PING -->
    <div class="screen-pane" id="pane-net">
      <div class="network-radar-view">
        <div class="topo-diagram">
          <div class="topo-node">
            <div class="node-box node-client">
              <span class="node-icon">💻</span>
              <span class="node-label mono">CLIENT</span>
            </div>
            <span class="node-ip mono">192.168.1.100</span>
          </div>

          <div class="topo-link">
            <div class="link-line">
              <span class="packet-dot"></span>
            </div>
            <span class="link-label mono" id="live-ping-val">12.4 ms</span>
          </div>

          <div class="topo-node">
            <div class="node-box node-router">
              <span class="node-icon">🖧</span>
              <span class="node-label mono">CISCO CCNA</span>
            </div>
            <span class="node-ip mono">10.0.0.1/24</span>
          </div>

          <div class="topo-link">
            <div class="link-line">
              <span class="packet-dot delayed"></span>
            </div>
            <span class="link-label mono">VLAN 10</span>
          </div>

          <div class="topo-node">
            <div class="node-box node-cloud">
              <span class="node-icon">☁️</span>
              <span class="node-label mono">SERVER</span>
            </div>
            <span class="node-ip mono">203.0.113.50</span>
          </div>
        </div>

        <div class="cisco-meta-box mono">
          <div class="meta-row">
            <span class="meta-title">&gt; CISCO CERTIFICATION:</span>
            <span class="meta-val text-yellow">CCNAv7 Introduction to Networks</span>
          </div>
          <div class="meta-row">
            <span class="meta-title">&gt; IT ESSENTIALS:</span>
            <span class="meta-val text-green">Hardware & OS Diagnostics Verified</span>
          </div>
          <div class="meta-row">
            <span class="meta-title">&gt; PACKET STATUS:</span>
            <span class="meta-val">0% Loss · TTL 64 · MTU 1500</span>
          </div>
        </div>
      </div>
    </div>

    <!-- PANE 3: K3 SAFETY & FIELD OFFICER -->
    <div class="screen-pane" id="pane-k3">
      <div class="k3-officer-view">
        <div class="k3-header-badge">
          <div class="k3-shield-icon">🦺</div>
          <div class="k3-titles">
            <h4 class="k3-main-title">K3 SAFETY & OCCUPATIONAL HEALTH</h4>
            <span class="k3-issuer mono">3S LEARNING CENTER CERTIFIED</span>
          </div>
        </div>

        <div class="k3-cert-grid">
          <div class="k3-item">
            <span class="k3-check">✓</span>
            <div class="k3-item-text">
              <strong>Job Safety Analysis (JSA)</strong>
              <span class="k3-sub">Risk Assessment & Hazard Mitigation</span>
            </div>
          </div>
          <div class="k3-item">
            <span class="k3-check">✓</span>
            <div class="k3-item-text">
              <strong>Fire Safety Officer (FSO)</strong>
              <span class="k3-sub">Emergency Response & Fire Protection</span>
            </div>
          </div>
          <div class="k3-item">
            <span class="k3-check">✓</span>
            <div class="k3-item-text">
              <strong>First Aid (Pertolongan Pertama)</strong>
              <span class="k3-sub">CPR, Trauma Management & Emergency Care</span>
            </div>
          </div>
          <div class="k3-item">
            <span class="k3-check">✓</span>
            <div class="k3-item-text">
              <strong>SMK3 / OHS Management System</strong>
              <span class="k3-sub">Safety Compliance & Policy Implementation</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deck Bottom: Quick Interactive Trigger -->
  <div class="deck-bottom-bar">
    <button class="btn btn-sm btn-primary deck-action-btn" id="ping-trigger-btn">
      <span>⚡ Test Ping Response</span>
    </button>
    <a href="#contact" class="btn btn-sm btn-blue deck-action-btn">
      <span>Hubungi Dhio 📨</span>
    </a>
    <span class="mono ping-feedback" id="ping-feedback-msg">&gt; Latency: 12ms (Ready)</span>
  </div>
</div>

<script>
  // Mode Tab Switcher Logic
  const tabs = document.querySelectorAll('.mode-tab-btn');
  const panes = document.querySelectorAll('.screen-pane');
  const feedbackMsg = document.getElementById('ping-feedback-msg');
  const pingBtn = document.getElementById('ping-trigger-btn');
  const livePingEl = document.getElementById('live-ping-val');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      panes.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const mode = tab.getAttribute('data-mode');
      const targetPane = document.getElementById(`pane-${mode}`);
      if (targetPane) {
        targetPane.classList.add('active');
      }
    });
  });

  // Interactive Ping Button
  if (pingBtn) {
    pingBtn.addEventListener('click', () => {
      const randomMs = (8 + Math.random() * 8).toFixed(1);
      if (feedbackMsg) {
        feedbackMsg.textContent = `> PING OK: ${randomMs}ms (Host Live)`;
        feedbackMsg.style.color = '#00C853';
      }
      if (livePingEl) {
        livePingEl.textContent = `${randomMs} ms`;
      }
      // Re-trigger animation on packet dots
      const dots = document.querySelectorAll('.packet-dot');
      dots.forEach(d => {
        (d as HTMLElement).style.animation = 'none';
        setTimeout(() => {
          (d as HTMLElement).style.animation = '';
        }, 10);
      });
    });
  }
</script>

<style>
  .deck-container {
    background: #FFFFFF;
    border: var(--border-thick);
    box-shadow: var(--shadow-hard);
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* Deck Header */
  .deck-header {
    background: var(--ink);
    color: #FFFFFF;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--ink);
  }

  .deck-id-badge {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .deck-avatar-box {
    width: 38px;
    height: 38px;
    background: var(--signal-yellow);
    color: var(--ink);
    border: 2px solid #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.25rem;
    position: relative;
    box-shadow: 2px 2px 0 rgba(255, 255, 255, 0.4);
  }

  .avatar-glow {
    position: absolute;
    inset: -2px;
    border: 1px solid var(--signal-yellow);
    opacity: 0.8;
  }

  .deck-id-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .deck-name-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--signal-yellow);
    letter-spacing: 0.05em;
  }

  .deck-status-line {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pulse-indicator {
    width: 7px;
    height: 7px;
    background-color: var(--terminal-green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--terminal-green);
    animation: pulse 1.5s infinite;
  }

  .status-text {
    font-size: 0.68rem;
    color: #C5CBD8;
  }

  /* Waveform */
  .deck-waveform {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
    padding: 2px;
  }

  .bar {
    width: 3px;
    background: var(--signal-yellow);
    border-radius: 1px;
    animation: bounce 1.2s infinite ease-in-out alternate;
  }

  .bar-1 { height: 35%; animation-delay: 0.1s; }
  .bar-2 { height: 80%; animation-delay: 0.3s; }
  .bar-3 { height: 50%; animation-delay: 0.2s; }
  .bar-4 { height: 100%; animation-delay: 0.4s; }
  .bar-5 { height: 65%; animation-delay: 0.15s; }
  .bar-6 { height: 90%; animation-delay: 0.35s; }
  .bar-7 { height: 40%; animation-delay: 0.25s; }
  .bar-8 { height: 75%; animation-delay: 0.45s; }

  @keyframes bounce {
    0% { transform: scaleY(0.3); }
    100% { transform: scaleY(1); }
  }

  /* Mode Switcher Tabs */
  .deck-mode-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: #E4E5EB;
    border-bottom: 2px solid var(--ink);
  }

  .mode-tab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 0.4rem;
    font-family: var(--font-subhead);
    font-size: 0.78rem;
    font-weight: 700;
    background: #E4E5EB;
    color: #444444;
    border: none;
    border-right: 1px solid var(--ink);
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .mode-tab-btn:last-child {
    border-right: none;
  }

  .mode-tab-btn:hover {
    background: #F0F1F5;
    color: var(--ink);
  }

  .mode-tab-btn.active {
    background: #FFFFFF;
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--signal-yellow);
  }

  .tab-icon {
    font-size: 0.95rem;
  }

  /* Screen Panes */
  .deck-screen {
    padding: 1rem;
    background: #FAFAFC;
    min-height: 215px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .screen-pane {
    display: none;
    animation: fadeIn 0.2s ease;
  }

  .screen-pane.active {
    display: block;
  }

  /* PANE 1: Code Editor Mock */
  .code-editor-mock {
    background: #111319;
    border: 2px solid var(--ink);
    padding: 0.75rem;
    color: #E2E8F0;
    margin-bottom: 0.75rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .editor-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #2B2F3D;
    padding-bottom: 0.4rem;
    margin-bottom: 0.5rem;
    font-size: 0.72rem;
    color: #94A3B8;
  }

  .tag-xs {
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
  }

  .code-body {
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .indent-1 {
    padding-left: 1rem;
  }

  .c-keyword { color: #F472B6; font-weight: 700; }
  .c-var { color: #60A5FA; }
  .c-type { color: #34D399; }
  .c-prop { color: #FBBF24; }
  .c-string { color: #A7F3D0; }
  .c-num { color: #F87171; }
  .c-bool { color: #818CF8; font-weight: 700; }
  .c-comment { color: #64748B; font-style: italic; }

  .interactive-tech-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .chip-yellow { background: var(--signal-yellow); color: var(--ink); }
  .chip-blue { background: var(--circuit-blue); color: #FFFFFF; }
  .chip-green { background: var(--terminal-green); color: var(--ink); }
  .chip-dark { background: var(--ink); color: #FFFFFF; }

  /* PANE 2: Network Radar */
  .network-radar-view {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .topo-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border: 2px solid var(--ink);
    padding: 0.75rem 0.5rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .topo-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .node-box {
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .node-client { background: #E0E7FF; }
  .node-router { background: var(--signal-yellow); }
  .node-cloud { background: #DCFCE7; }

  .node-icon { font-size: 1.1rem; line-height: 1; }
  .node-label { font-size: 0.55rem; font-weight: 700; color: var(--ink); }
  .node-ip { font-size: 0.6rem; color: #555555; }

  .topo-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0 0.35rem;
  }

  .link-line {
    width: 100%;
    height: 3px;
    background: var(--ink);
    position: relative;
  }

  .packet-dot {
    position: absolute;
    top: -3px;
    left: 0;
    width: 9px;
    height: 9px;
    background: var(--terminal-green);
    border: 1px solid var(--ink);
    border-radius: 50%;
    animation: flowPacket 2s infinite linear;
  }

  .packet-dot.delayed {
    animation-delay: 1s;
  }

  @keyframes flowPacket {
    0% { left: 0%; }
    100% { left: 90%; }
  }

  .link-label {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--circuit-blue);
    background: #FFFFFF;
    padding: 0 0.2rem;
  }

  .cisco-meta-box {
    background: #151822;
    border: 1px solid var(--ink);
    padding: 0.5rem 0.75rem;
    font-size: 0.72rem;
    color: #E2E8F0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .meta-title { color: #94A3B8; }
  .text-yellow { color: var(--signal-yellow); font-weight: 700; }
  .text-green { color: #4ADE80; font-weight: 700; }

  /* PANE 3: K3 Safety View */
  .k3-officer-view {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .k3-header-badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFFDF0;
    border: 2px solid var(--ink);
    padding: 0.5rem 0.75rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .k3-shield-icon {
    font-size: 1.6rem;
  }

  .k3-main-title {
    font-size: 0.88rem;
    color: var(--ink);
  }

  .k3-issuer {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--circuit-blue);
  }

  .k3-cert-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  @media (min-width: 500px) {
    .k3-cert-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .k3-item {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    background: #FFFFFF;
    border: 1px solid var(--ink);
    padding: 0.4rem 0.55rem;
    font-size: 0.76rem;
  }

  .k3-check {
    color: #059669;
    font-weight: 900;
    font-size: 0.8rem;
  }

  .k3-item-text {
    display: flex;
    flex-direction: column;
  }

  .k3-sub {
    font-size: 0.66rem;
    color: #666666;
  }

  /* Deck Bottom Bar */
  .deck-bottom-bar {
    background: #FFFFFF;
    border-top: 2px solid var(--ink);
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .deck-action-btn {
    font-size: 0.75rem;
  }

  .ping-feedback {
    font-size: 0.72rem;
    font-weight: 700;
    color: #555555;
  }
</style>
