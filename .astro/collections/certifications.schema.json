{
  "$ref": "#/definitions/certifications",
  "definitions": {
    "certifications": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "network",
            "safety",
            "it",
            "other"
          ],
          "default": "other"
        },
        "code": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "default": "Verified"
        },
        "order": {
          "type": "number",
          "default": 0
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "issuer"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}